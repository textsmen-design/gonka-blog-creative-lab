---
// src/components/SubdomainNetwork.astro

const nodes = [
  {
    domain: "gonka.blog",
    role: "МАТЕРИНСКИЙ СТОЛ (HUB)",
    desc: "Главная лаборатория, реестр артефактов, конвейер стадий и бортовой журнал.",
    status: "ACTIVE HOST",
    color: "#ea580c"
  },
  {
    domain: "reloca.gonka.blog",
    role: "ВЫНОСНОЙ ВЕРСТАК: SERBIA RELOCATION",
    desc: "Большой независимый продукт: сервисы, гайды и комьюнити по релокации в Сербию.",
    status: "STANDALONE PRODUCT",
    color: "#2563eb"
  },
  {
    domain: "bot.gonka.blog",
    role: "СЕРВЕР БОТОВ & АВТОМАТИЗАЦИЙ",
    desc: "Шлюз для взаимодействия с Telegram-инфраструктурой, майнинг-ботом и API-эндпоинтами.",
    status: "ONLINE",
    color: "#16a34a"
  },
  {
    domain: "english.gonka.blog",
    role: "AI-РЕЧЕВОЙ ПОЛИГОН",
    desc: "Интерактивный голосовой тренажер разговорного английского на базе Speech AI.",
    status: "LAB TEST",
    color: "#9333ea"
  }
];
---

<section id="ecosystem" class="py-16 border-t transition-colors duration-700"
         style="background: var(--desk-card); border-color: var(--desk-border);">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10 pb-6 border-b"
         style="border-color: var(--desk-border);">
      <div>
        <div class="font-['JetBrains_Mono'] text-xs uppercase tracking-widest text-orange-600 mb-1">
          // ЭКОСИСТЕМА ПОДДОМЕНОВ & ВЫНОСНЫХ ВЕРСТАКОВ
        </div>
        <h2 class="font-['Space_Grotesk'] text-3xl sm:text-4xl font-bold tracking-tight"
            style="color: var(--desk-text);">
          Федеративная сеть цифровых продуктов
        </h2>
      </div>
      <div class="font-['JetBrains_Mono'] text-xs opacity-75" style="color: var(--desk-muted);">
        ЕДИНАЯ ТОЧКА ВХОДА: GONKA.BLOG
      </div>
    </div>

    <!-- Интерактивная карта поддоменов -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {nodes.map((node) => (
        <div class="group rounded-xl border p-5 flex flex-col justify-between transition-all duration-300 hover:border-orange-500 hover:-translate-y-1"
             style="background: var(--desk-base); border-color: var(--desk-border);">
          
          <div>
            <div class="flex items-center justify-between font-['JetBrains_Mono'] text-[10px] mb-3"
                 style="color: var(--desk-muted);">
              <span class="font-bold flex items-center gap-1.5" style={`color: ${node.color}`}>
                <span class="w-1.5 h-1.5 rounded-full" style={`background: ${node.color}`}></span>
                {node.status}
              </span>
              <span>NODE</span>
            </div>

            <h3 class="font-['JetBrains_Mono'] text-base font-bold tracking-tight group-hover:text-orange-600 transition-colors"
                style="color: var(--desk-text);">
              {node.domain}
            </h3>

            <div class="font-['Space_Grotesk'] text-xs font-semibold text-orange-600 uppercase tracking-wider mt-1">
              {node.role}
            </div>

            <p class="mt-3 text-xs leading-relaxed" style="color: var(--desk-muted);">
              {node.desc}
            </p>
          </div>

          <div class="mt-6 pt-3 border-t font-['JetBrains_Mono'] text-[11px] flex items-center justify-between"
               style="border-color: var(--desk-border); color: var(--desk-muted);">
            <span>Шильдик: MADE IN GONKA</span>
            <span class="group-hover:text-orange-600 transition-colors">Перейти ↗</span>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>

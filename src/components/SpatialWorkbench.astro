  .dot-amber { background: #d97706; }
  .dot-rose { background: #e11d48; }
  .dot-purple { background: #9333ea; }

  /* ПРАВАЯ ВЫДВИЖНАЯ ПАНЕЛЬ (DRAWER) — ЧАСТЬ ОБЩЕЙ СРЕДЫ РАБОЧЕГО СТОЛА */
  .workbench-drawer {
    position: fixed;
    top: 42px;
    right: 0;
    bottom: 32px;
    width: 500px;
    max-width: 100vw;
    background: #171412;
    background-image: 
      radial-gradient(circle at 100% 0%, rgba(245, 158, 11, 0.08) 0%, transparent 60%),
      radial-gradient(circle at 0% 100%, rgba(180, 83, 9, 0.05) 0%, transparent 50%),
      linear-gradient(180deg, rgba(28, 24, 21, 0.98) 0%, rgba(20, 17, 15, 0.98) 100%);
    backdrop-filter: blur(24px);
    border-left: 1px solid rgba(245, 158, 11, 0.22);
    box-shadow: -24px 0 60px rgba(0, 0, 0, 0.75), inset 1px 0 0 rgba(255, 255, 255, 0.05);
    z-index: 60;
    transform: translateX(110%);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), width 0.4s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.4s;
    color: #ede8df;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .workbench-drawer:not(.is-open) {
    box-shadow: none !important;
    visibility: hidden;
    pointer-events: none;
  }

  /* АТМОСФЕРА ПАНЕЛЕЙ ПО ТИПАМ ПРОЕКТОВ (ЛАБОРАТОРНЫЕ ПОВЕРХНОСТИ) */

  /* 1. БОТЫ (код / терминал / сообщения / автоматизация) */
  #modal-myasnaya-troitsa,
  #modal-aichatbot,

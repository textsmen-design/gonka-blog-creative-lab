  .scene-stage .hotspot-scroll.physical-scroll-object { left: 28.6%; top: 77.6%; width: 223px; height: 212px; scale: calc(var(--k) * 0.8); }
  .scene-stage .hotspot-scroll-bots.physical-scroll-bots { left: 37.1%; top: 79.8%; width: 275px; height: 160px; }

  .scene-stage .sites-closed-wrapper,
  .scene-stage .bots-closed-wrapper,
  .scene-stage .scroll-closed-wrapper { pointer-events: none; }
  /* Область наведения/клика = реальный силуэт закрытого свитка (по альфа-каналу svitok-closed.png), а не рамка вокруг */
  .scene-stage .sites-closed-img,
  .scene-stage .bots-closed-img,
  .scene-stage .scroll-closed-img {
    pointer-events: auto; cursor: pointer;
    clip-path: polygon(0.0% 65.0%, 2.2% 51.1%, 9.0% 38.7%, 64.8% 0.0%, 92.1% 0.7%, 94.8% 8.0%, 99.6% 43.1%, 99.3% 50.4%, 94.4% 55.5%, 18.7% 99.3%, 11.2% 97.8%, 6.4% 92.7%, 1.5% 81.0%);
  }
  /* Раскрытая часть свитка — только картинка: мышь проходит сквозь неё к соседним предметам */
  .scene-stage .bots-unrolled-wrapper,
  .scene-stage .scroll-unrolled-wrapper,
  .scene-stage .bots-unrolled-img,
  .scene-stage .scroll-open-img { pointer-events: none !important; }
  /* Лендинги: пергамент компактный и лежит на карте — он остаётся кликабельным (клик вне чипов открывает каталог) */
  .scene-stage .sites-unrolled-wrapper { pointer-events: none; }
  .scene-stage .hotspot-scroll-sites:hover .sites-unrolled-wrapper,
  .scene-stage .hotspot-scroll-sites.is-hovered .sites-unrolled-wrapper,
  .scene-stage .hotspot-scroll-sites:has(:focus-visible) .sites-unrolled-wrapper { pointer-events: auto; }
  /* Кликабельные элементы раскрытого свитка существуют для мыши только пока свиток раскрыт (иначе это «невидимые зоны») */
  .scene-stage .bots-spine,
  .scene-stage .phone-interactive-hotspot,
  .scene-stage .sites-screens-strip { pointer-events: none; }
  .scene-stage .hotspot-scroll-bots:hover .bots-spine,
  .scene-stage .hotspot-scroll-bots:hover .phone-interactive-hotspot,
  .scene-stage .hotspot-scroll-bots.is-hovered .bots-spine,
  .scene-stage .hotspot-scroll-bots.is-hovered .phone-interactive-hotspot,
  .scene-stage .hotspot-scroll-bots:focus-visible .phone-interactive-hotspot,
  .scene-stage .hotspot-scroll-bots:has(:focus-visible) .phone-interactive-hotspot,
  .scene-stage .hotspot-scroll-sites:hover .sites-screens-strip,
  .scene-stage .hotspot-scroll-sites.is-hovered .sites-screens-strip,
  .scene-stage .hotspot-scroll-sites:has(:focus-visible) .sites-screens-strip { pointer-events: auto; }
  /* «мостик» от закрытого свитка к карточкам на телефоне: узкая колонка, чтобы можно было дойти до кнопок и не закрыть телефон */
  .scene-stage .bots-spine { position: absolute; left: 41%; width: 18%; top: 25%; height: 58%; z-index: 9; }
  /* раскрытый свиток визуально выше соседних, но события мыши он не перехватывает */
  .scene-stage .hotspot-scroll-sites:hover,
  .scene-stage .hotspot-scroll-bots:hover,
  .scene-stage .hotspot-scroll:hover,
  .scene-stage .hotspot-scroll-sites.is-hovered,
  .scene-stage .hotspot-scroll-bots.is-hovered,
  .scene-stage .hotspot-scroll.is-hovered { z-index: 620; }
  /* телефон «Боты» раскрывается вверх от свитка и не выходит за нижний край сцены */
  .scene-stage .bots-unrolled-wrapper { top: auto; bottom: 0; transform: translate(-50%, 0) scale(0.92) rotate(-1.5deg); transition-duration: 0.55s; }
  .scene-stage .hotspot-scroll-bots:hover .bots-unrolled-wrapper,
  .scene-stage .hotspot-scroll-bots:has(:focus-visible) .bots-unrolled-wrapper,
  .scene-stage .hotspot-scroll-bots.is-hovered .bots-unrolled-wrapper { transform: translate(-50%, 0) scale(1) rotate(-1.5deg); }
  /* клавиатура: те же состояния, что у hover */
  .scene-stage .hotspot-scroll-sites:focus-visible .sites-closed-wrapper,

  /* КАТАЛОГ САЙТОВ И ЛЕНДИНГОВ В ПРАВОЙ ПАНЕЛИ */
  .sites-catalog-grid {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 8px;
  }
  .workbench-drawer.is-expanded .sites-catalog-grid {

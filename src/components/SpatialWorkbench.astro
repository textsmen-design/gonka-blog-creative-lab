  /* 4. СВИТОК «САЙТЫ / ЛЕНДИНГИ» (ГОРИЗОНТАЛЬНЫЙ ФИЗИЧЕСКИЙ СВИТОК НА СТОЛЕ) */
  .hotspot-scroll-sites.physical-scroll-horizontal {
    position: absolute;
    top: 40.0%;
    left: 24.8%;

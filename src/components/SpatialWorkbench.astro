    mix-blend-mode: screen;
  }

  /* ЕСТЕСТВЕННАЯ ФИЗИЧЕСКАЯ ГЕОМЕТРИЯ И ГРАНИЦЫ СТОЛЕШНИЦЫ */
  .workbench-tabletop-geometry {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 18;
  }

  /* 1. Правая граница: контактная тень прямо по линии стыка с вертикальной стойкой */
  .tabletop-right-junction {
    position: absolute;
    top: 6.5%;
    bottom: 0;
    left: 84.75%;
    width: 2px;
    background: rgba(0, 0, 0, 0.65);
    box-shadow: -2px 0 6px rgba(0, 0, 0, 0.35), 1px 0 2px rgba(255, 215, 140, 0.2);
    pointer-events: none;
  }

  /* 2. Передний торец столешницы: фаска и толщина массива дерева к зрителю */
  .tabletop-front-edge {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 44px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    pointer-events: none;
    z-index: 22;
  }

  /* Верхняя микро-фаска торца (теплый закатный блик по передней кромке дерева) */
  .front-edge-bevel {
    width: 100%;
    height: 4px;
    background: linear-gradient(90deg, 
      rgba(217, 119, 6, 0.4) 0%, 
      rgba(255, 235, 190, 0.95) 15%, 
      rgba(255, 245, 215, 1.0) 50%, 
      rgba(255, 230, 175, 0.95) 85%, 
      rgba(217, 119, 6, 0.4) 100%
    );
    box-shadow: 0 -3px 12px rgba(255, 205, 130, 0.6), 0 1px 3px rgba(0, 0, 0, 0.9);
  }

  /* Массивный торец деревянной плиты со спадом в глубокую тень */
  .front-edge-thickness {
    width: 100%;
    height: 42px;
    background: 
      repeating-linear-gradient(180deg, 
        rgba(255, 255, 255, 0.03) 0px, 
        rgba(255, 255, 255, 0.03) 1px, 
        transparent 1px, 
        transparent 4px
      ),
      linear-gradient(180deg, 
        #3b271a 0%, 
        #2a1c12 25%, 
        #1e130b 55%, 
        #120a06 85%,
        #080402 100%
      );
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.98);
  }

  /* ЛОГОТИП GONKA.BLOG НА ГЛАВНОМ СТОЛЕ (ССЫЛКА НА /) */

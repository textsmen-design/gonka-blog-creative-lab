    transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 20;
    outline: none;
  }

  .hotspot-aura {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    opacity: 0;
    transition: opacity 0.25s ease, box-shadow 0.25s ease;
    pointer-events: none;
  }

  .hotspot:hover .hotspot-aura,
  .hotspot.is-hovered .hotspot-aura {
    opacity: 1;
    box-shadow: 0 0 20px rgba(249, 115, 22, 0.4), inset 0 0 10px rgba(249, 115, 22, 0.15);
  }

  /* 1. ТЕЛЕФОН */
  .hotspot-phone {
    top: 3.5%;
    left: 0.8%;
    width: 23.5%;
    height: 30.0%;
    border-radius: 16px;

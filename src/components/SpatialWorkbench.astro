  }
  .label-above-left {
    top: -42px;
    left: 10px;
    transform: translateY(-6px);
  }
  .label-above-center {
    top: -42px;
    left: 50%;
    transform: translate(-50%, -6px);
  }
  .label-above-right {
    top: -42px;
    right: 10px;
    transform: translateY(-6px);
  }

  /* Крафтовая бирка «БОТЫ // TELEGRAM», закрепленная на свернутом свитке */
  .bots-closed-tag {
    position: absolute;
    bottom: -6px;
    left: 50%;
    transform: translateX(-50%) rotate(-2.5deg);

  /* БЛОКИ ОПИСАНИЯ И ОСОБЕННОСТЕЙ В КАТАЛОГЕ БОТОВ */
  .catalog-card-block {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 7px 10px;
    background: rgba(15, 12, 10, 0.55);
    border: 1px solid rgba(245, 158, 11, 0.15);
    border-radius: 6px;
  }
  .catalog-block-title {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px;
    font-weight: 700;
    color: #f59e0b;
    letter-spacing: 0.05em;
  }
  .catalog-block-text {
    font-size: 11px;
    line-height: 1.4;
    color: #d6d3d1;
    margin: 0;
  }
  .catalog-features-list {
    margin: 0;
    padding-left: 14px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .catalog-features-list li {
    font-size: 11px;
    line-height: 1.35;
    color: #e7e5e4;
  }

  /* БАННЕР РЕАЛЬНОГО ПЕРВОГО ЭКРАНА В ДОСЬЕ ПРОЕКТА */
  .dossier-screen-preview {
    position: relative;
    width: 100%;
    margin-bottom: 20px;
    border-radius: 8px;
    overflow: hidden;
    background: #0d0a08;
    border: 1px solid rgba(245, 158, 11, 0.28);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  .dossier-screen-img {
    width: 100%;
    max-height: 280px;
    object-fit: cover;
    object-position: top center;
    display: block;
    transition: transform 0.35s ease;
  }

  .workbench-drawer.is-expanded .dossier-screen-img {
    max-height: 440px;
  }

  .dossier-screen-preview:hover .dossier-screen-img {
    transform: scale(1.015);
  }

  .dossier-screen-caption {
    padding: 7px 12px;
    background: rgba(20, 16, 13, 0.95);
    border-top: 1px solid rgba(245, 158, 11, 0.18);
    display: flex;
    align-items: center;
    gap: 7px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.05em;

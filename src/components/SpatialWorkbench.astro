    height: 21.8%;
    border: none;
    background: transparent;
    padding: 0;
    margin: 0;
    cursor: pointer;
    z-index: 35;
    outline: none;
    box-shadow: none;
    transform: none;
    -webkit-tap-highlight-color: transparent;
  }

  .hotspot-scroll.physical-scroll-object:hover,
  .hotspot-scroll.physical-scroll-object.is-hovered {
    border: none;
    box-shadow: none;
    transform: none;
  }

  .hotspot-scroll.physical-scroll-object:focus-visible {
    outline: 2px dashed rgba(245, 158, 11, 0.7);
    outline-offset: 4px;
    border-radius: 8px;
  }

  /* 1. Закрытый рулон на столе (исходное состояние) */
  .scroll-closed-wrapper {
    position: absolute;
    top: 14%;
    left: 5%;
    width: 90%;
    height: auto;
    pointer-events: auto;
    transition: opacity 0.32s cubic-bezier(0.16, 1, 0.3, 1), transform 0.32s cubic-bezier(0.16, 1, 0.3, 1);
    transform-origin: center center;
    filter: drop-shadow(0 8px 18px rgba(0, 0, 0, 0.75));
  }

  .scroll-closed-img {
    display: block;
    width: 100%;
    height: auto;
    user-select: none;
    pointer-events: none;
  }

  /* Крафтовая бирка «АВТОР», закрепленная на свернутом свитке */
  .scroll-closed-tag {
    position: absolute;
    bottom: -6px;
    left: 50%;
    transform: translateX(-50%) rotate(-4deg);
    padding: 2.5px 8px;
    background: #eadebe;
    background-image: linear-gradient(135deg, #f5ebd2 0%, #d8be92 100%);
    border: 1px solid rgba(120, 75, 30, 0.5);
    border-radius: 3px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.5);
    pointer-events: none;
    white-space: nowrap;
    z-index: 2;
  }

  .scroll-closed-tag span {
    font-family: 'Space Grotesk', -apple-system, sans-serif;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.16em;
    color: #431407;
    text-transform: uppercase;
    display: block;
  }

  /* Деликатный пульсирующий отблеск на сургучной печати */
  .scroll-pulse-seal {
    position: absolute;
    top: 36%;
    left: 58%;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(239, 68, 68, 0.5) 0%, rgba(220, 38, 38, 0.15) 50%, rgba(0, 0, 0, 0) 70%);
    pointer-events: none;
    animation: scroll-seal-shimmer 3.2s infinite ease-in-out;
  }

  @keyframes scroll-seal-shimmer {
    0%, 100% {
      transform: translate(-50%, -50%) scale(0.9);
      opacity: 0.35;
    }
    50% {
      transform: translate(-50%, -50%) scale(1.35);
      opacity: 0.85;
    }
  }

  /* 2. Развёрнутый свиток (разворачивается вниз строго в свободной области, не закрывая лендинги) */
  .scroll-unrolled-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    transform: scaleY(0.18) translateY(-10px);
    transform-origin: top center;
    clip-path: inset(0 0 82% 0);
    filter: drop-shadow(0 16px 30px rgba(0, 0, 0, 0.85));
    transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.42s cubic-bezier(0.16, 1, 0.3, 1),
                clip-path 0.42s cubic-bezier(0.16, 1, 0.3, 1),
                filter 0.42s ease;
  }

  .scroll-open-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: top center;
    user-select: none;
    pointer-events: none;
  }

  /* Штамп «ОБО МНЕ» на развёрнутом пергаменте */
  .scroll-unrolled-stamp {
    position: absolute;
    top: 18%;
    left: 50%;
    transform: translateX(-50%) rotate(-2.5deg);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .scroll-stamp-tag {
    font-family: 'Space Grotesk', -apple-system, sans-serif;
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.22em;
    color: #431407;
    background: rgba(245, 230, 203, 0.88);
    border: 1px dashed rgba(120, 53, 15, 0.5);
    padding: 2px 8px;
    border-radius: 3px;
    text-transform: uppercase;
    box-shadow: 0 1px 4px rgba(67, 20, 7, 0.2);
    backdrop-filter: blur(2px);
  }

  /* Реакция на hover и is-hovered */
  .hotspot-scroll.physical-scroll-object:hover .scroll-closed-wrapper,
  .hotspot-scroll.physical-scroll-object.is-hovered .scroll-closed-wrapper {
    opacity: 0;
    transform: scale(0.94) translateY(-4px);
    pointer-events: none;
  }

  .hotspot-scroll.physical-scroll-object:hover .scroll-unrolled-wrapper,
  .hotspot-scroll.physical-scroll-object.is-hovered .scroll-unrolled-wrapper {
    opacity: 1;
    pointer-events: auto;
    transform: scaleY(1) translateY(0);
    clip-path: inset(0 0 0 0);
    filter: drop-shadow(0 22px 38px rgba(0, 0, 0, 0.9));
  }

  /* 12. КРУЖКА */
  .hotspot-mug {
    top: 11.0%;
    left: 68.0%;
    width: 10.5%;
    height: 18.0%;
    border-radius: 50%;
  }

  /* 13. ПРАВАЯ ВЕРТИКАЛЬНАЯ НАВИГАЦИЯ (ОГЛАВЛЕНИЕ СТОЛА — 8 РАЗДЕЛОВ) */
  .cabinet-menu-nav {
    position: absolute;
    top: 27.5%;
    left: 86.6%;
    width: 12.0%;
    height: 46.5%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 5px;
    z-index: 28;
    pointer-events: auto;
  }

  /* Фоновые темные деревянные рейки под меню — надежно закрывают старые фоновые надписи */
  .cabinet-nav-backdrop {
    position: absolute;
    inset: -4px 0;
    background: #17110c;
    background-image: 
      repeating-linear-gradient(180deg, 
        #17110c 0px, 
        #211812 3px, 
        #2a1e16 24px, 
        #1b130e 45px, 
        #0e0a07 48px, 
        #050403 50px
      );
    border-radius: 3px;
    box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.7);
    z-index: -1;
    pointer-events: none;
  }

  /* ЕДИНЫЙ СТИЛЬ ДЛЯ ВСЕХ 8 ПУНКТОВ МЕНЮ */
  .cabinet-nav-item {
    position: relative;
    width: 100%;
    flex: 1;
    min-height: 32px;
    max-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(180deg, #ede3d2 0%, #dfd3bd 100%);
    border: 1px solid rgba(130, 85, 45, 0.45);
    border-radius: 4px;
    box-shadow: 
      0 2px 5px rgba(0, 0, 0, 0.6),
      inset 0 1px 0 rgba(255, 255, 255, 0.65),
      inset 0 -1px 0 rgba(0, 0, 0, 0.1);
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    outline: none;
    padding: 0 6px;
  }

  /* Латунные заклепки по углам планок */
  .cabinet-nav-item::before,
  .cabinet-nav-item::after {
    content: '';
    position: absolute;
    width: 3px;
    height: 3px;
    background: #55331c;
    border-radius: 50%;
    box-shadow: 0 0.5px 1px rgba(255, 255, 255, 0.5);
    opacity: 0.6;
  }
  .cabinet-nav-item::before { top: 4px; left: 6px; }
  .cabinet-nav-item::after { top: 4px; right: 6px; }

  /* Одинаковая типографика для всех 8 пунктов */
  .cabinet-nav-label {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #2b180d;
    text-transform: uppercase;
    text-shadow: 0 0.5px 0 rgba(255, 255, 255, 0.45);
    white-space: nowrap;
    pointer-events: none;
  }

  /* Одинаковый Hover для всех 8 пунктов */
  .cabinet-nav-item:hover,
  .cabinet-nav-item:focus-visible,
  .cabinet-nav-item.is-hovered {
    background: linear-gradient(180deg, #f5ebd9 0%, #ede0c9 100%);
    border-color: rgba(245, 158, 11, 0.8);
    box-shadow: 
      0 0 16px rgba(245, 158, 11, 0.4),
      0 3px 8px rgba(0, 0, 0, 0.7),
      inset 0 1px 0 rgba(255, 255, 255, 0.85);
    transform: translateX(-2.5px);
  }

  /* Одинаковое активное состояние для всех 8 пунктов */
  .cabinet-nav-item.is-active,
  .cabinet-nav-item:active {
    background: linear-gradient(180deg, #dfd3bd 0%, #cfc1a7 100%);
    border-color: #ea580c;
    box-shadow: 
      0 0 12px rgba(234, 88, 12, 0.4),
      inset 0 2px 4px rgba(0, 0, 0, 0.25);
    transform: translateX(-1px);
  }


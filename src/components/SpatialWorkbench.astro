  /* НИЖНЯЯ ПАНЕЛЬ */
  .desk-bottombar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 32px;
    padding: 0 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--nav-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1px solid rgba(245, 158, 11, 0.2);
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    z-index: 50;
    flex-shrink: 0;
  }

  .bottombar-left-zone {
    display: flex;
    align-items: center;
    gap: 8px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .hint-bold { font-weight: 700; color: #ea580c; }
  .hint-divider { color: #5e5950; }
  .hint-sub { color: #a8a29e; }

  .bottombar-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .contact-wire-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px 7px;
    border-radius: 4px;
    background: var(--desk-card);
    border: 1px solid var(--desk-border);
    color: var(--desk-text);
    text-decoration: none;
    font-size: 10px;
    font-weight: 600;
    transition: all 0.2s ease;
  }
  .contact-wire-btn:hover {
    border-color: #ea580c;
    color: #ea580c;
    transform: translateY(-1px);
  }

  .wire-dot { width: 5px; height: 5px; border-radius: 9999px; }
  .dot-sky { background: #0284c7; }
  .dot-amber { background: #d97706; }
  .dot-rose { background: #e11d48; }
  .dot-purple { background: #9333ea; }

  /* ПРАВАЯ ВЫДВИЖНАЯ ПАНЕЛЬ (DRAWER) — ЧАСТЬ ОБЩЕЙ СРЕДЫ РАБОЧЕГО СТОЛА */
  .workbench-drawer {
    position: fixed;
    top: 42px;
    right: 0;
    bottom: 32px;
    width: 500px;
    max-width: 100vw;
    background: #171412;
    background-image: 
      radial-gradient(circle at 100% 0%, rgba(245, 158, 11, 0.08) 0%, transparent 60%),
      radial-gradient(circle at 0% 100%, rgba(180, 83, 9, 0.05) 0%, transparent 50%),
      linear-gradient(180deg, rgba(28, 24, 21, 0.98) 0%, rgba(20, 17, 15, 0.98) 100%);
    backdrop-filter: blur(24px);
    border-left: 1px solid rgba(245, 158, 11, 0.22);
    box-shadow: -24px 0 60px rgba(0, 0, 0, 0.75), inset 1px 0 0 rgba(255, 255, 255, 0.05);
    z-index: 60;
    transform: translateX(110%);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), width 0.4s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.4s;
    color: #ede8df;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .workbench-drawer:not(.is-open) {
    box-shadow: none !important;
    visibility: hidden;
    pointer-events: none;
  }

  /* АТМОСФЕРА ПАНЕЛЕЙ ПО ТИПАМ ПРОЕКТОВ (ЛАБОРАТОРНЫЕ ПОВЕРХНОСТИ) */


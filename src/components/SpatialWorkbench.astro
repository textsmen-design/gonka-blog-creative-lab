    font-weight: 800;
    letter-spacing: 0.16em;
    color: #064e3b;
    text-transform: uppercase;
    display: block;
  }

  /* Пульсирующий отблеск на сургучной печати закрытого рулона */
  .bots-pulse-seal {
    position: absolute;
    top: 36%;
    left: 58%;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(16, 185, 129, 0.55) 0%, rgba(5, 150, 105, 0.15) 50%, rgba(0, 0, 0, 0) 70%);
    pointer-events: none;
    animation: scroll-seal-shimmer 3.2s infinite ease-in-out;
    z-index: 3;
  }

  /* 2. Развёрнутый свиток (физически разворачивается, на нём лежит настоящий смартфон) */
  .bots-unrolled-wrapper {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.92) rotate(-1.5deg);
    transform-origin: center center;
    width: 100%;
    max-width: 275px;
    height: auto;
    aspect-ratio: 400 / 658;
    pointer-events: none;
    opacity: 0;
    filter: drop-shadow(0 16px 36px rgba(0, 0, 0, 0.9));
    transition: opacity 0.32s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.38s cubic-bezier(0.16, 1, 0.3, 1),
                filter 0.38s ease;
    z-index: 45;
  }

  .hotspot-scroll-bots:hover .bots-closed-wrapper,
  .hotspot-scroll-bots:focus-within .bots-closed-wrapper,
  .hotspot-scroll-bots.is-hovered .bots-closed-wrapper {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.88);
    pointer-events: none;
  }

  .hotspot-scroll-bots:hover .bots-unrolled-wrapper,
  .hotspot-scroll-bots:focus-within .bots-unrolled-wrapper,
  .hotspot-scroll-bots.is-hovered .bots-unrolled-wrapper {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, -50%) scale(1) rotate(-1.5deg);
    filter: drop-shadow(0 26px 52px rgba(0, 0, 0, 0.95));

---
// src/components/SpatialWorkbench.astro
---

<div id="spatial-canvas-container" class="spatial-root select-none">

  <!-- ВЕРХНЯЯ РАМА ВЕРСТАКА -->
  <header class="desk-topbar">
    
    <!-- Левая группа: Статус лаборатории и время -->
    <div class="topbar-left">
      <div class="status-pill">
        <span class="live-pulse-wrapper">
          <span class="pulse-ring"></span>
          <span class="pulse-dot"></span>
        </span>
        <span class="status-text">СТОЛ В РАБОТЕ</span>
      </div>

      <div class="meta-coords">
        <span>ВРЕМЯ: <strong id="live-clock">22:15:00 CET</strong></span>
        <span>•</span>
        <span>45°15'N 19°51'E</span>
        <span>•</span>
        <span>VIBE CODING</span>
      </div>
    </div>

    <!-- Центр: бренд GONKA.BLOG -->
    <a href="/" class="topbar-brand" title="GONKA.BLOG">
      <span class="brand-title">GONKA<span class="brand-orange">.BLOG</span></span>
      <span class="brand-sub">// digital lab</span>
    </a>

    <!-- Правая группа: Тумблер освещения + Соцсети/Связь -->
    <div class="topbar-right">
      <button id="desk-theme-toggle" class="theme-btn" type="button" title="Переключить свет в лаборатории">
        <span id="desk-theme-icon">☼</span>
        <span id="desk-theme-label">ДЕНЬ</span>
      </button>

      <div class="topbar-links-group" aria-label="Контакты и социальные сети">
        <a href="https://t.me/lonelysvobodny" target="_blank" rel="noopener noreferrer" class="topbar-social-btn topbar-btn-tg" title="Связаться в Telegram (@lonelysvobodny)">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
          </svg>
          <span>Telegram</span>
        </a>

        <a href="mailto:textsmen@gmail.com" class="topbar-social-btn topbar-btn-email" title="Написать на Email (textsmen@gmail.com)">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="16" x="2" y="4" rx="2"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
          <span>Email</span>
        </a>

        <a href="#youtube" class="topbar-social-btn topbar-btn-yt" title="YouTube канал (в разработке)">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
          <span>YouTube</span>
        </a>

        <a href="#instagram" class="topbar-social-btn topbar-btn-ig" title="Instagram профиль (в разработке)">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
            <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
          </svg>
          <span>Instagram</span>
        </a>
      </div>
    </div>

  </header>

  <!-- ЦЕНТРАЛЬНЫЙ СВЕТОВОЙ СТОЛ -->
  <main class="workbench-viewport">
    
    <div id="workbench-canvas" class="workbench-frame">
      
      <!-- Фоновое изображение верстака -->
      <img src="/logo2.png" alt="GONKA.BLOG Digital Laboratory Workbench" class="workbench-bg-image" />

      <!-- ФИЗИЧЕСКАЯ ГЕОМЕТРИЯ И ГРАНИЦЫ СТОЛЕШНИЦЫ -->
      <div class="workbench-tabletop-geometry" aria-hidden="true">
        <!-- 1. Контактный стык со стойкой шкафа справа -->
        <div class="tabletop-right-junction"></div>

        <!-- 2. Передний торец столешницы: фаска, толщина деревянного массива и тень глубины к зрителю -->
        <div class="tabletop-front-edge">
          <div class="front-edge-bevel"></div>
          <div class="front-edge-thickness"></div>
        </div>
      </div>

      <!-- Рассеянный световой луч заката -->
      <div id="ambient-light-beam" class="workbench-light-overlay"></div>

      <!-- ЛОГОТИП GONKA.BLOG НА СТОЛЕ (ССЫЛКА НА ГЛАВНУЮ) -->
      <a 
        href="/" 
        class="workbench-table-logo-link" 
        title="GONKA.BLOG — Главная страница"
        aria-label="GONKA.BLOG: цифровая лаборатория — на главную"
      >
        <span class="sr-only">GONKA.BLOG: цифровая лаборатория // проекты • эксперименты • идеи</span>
      </a>

      <!-- ССЫЛКИ В ПРАВОМ ВЕРХНЕМ УГЛУ СТОЛА (TELEGRAM, EMAIL, YOUTUBE, INSTAGRAM) -->
      <a 
        href="https://t.me/lonelysvobodny" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="workbench-corner-link corner-link-telegram" 
        title="Telegram (@lonelysvobodny)"
        aria-label="Связаться в Telegram: @lonelysvobodny"
      >
        <span class="corner-link-tooltip">Telegram</span>
        <span class="corner-link-aura"></span>
      </a>

      <a 
        href="mailto:textsmen@gmail.com" 
        class="workbench-corner-link corner-link-email" 
        title="Email (textsmen@gmail.com)"
        aria-label="Написать на почту: textsmen@gmail.com"
      >
        <span class="corner-link-tooltip">Email</span>
        <span class="corner-link-aura"></span>
      </a>

      <a 
        href="#youtube" 
        class="workbench-corner-link corner-link-youtube" 
        title="YouTube канал (в разработке)"
        aria-label="YouTube канал GONKA.BLOG (в разработке)"
      >
        <svg class="corner-svg-icon" viewBox="0 0 24 24" fill="currentColor">
          <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
        </svg>
        <span class="corner-link-tooltip">YouTube</span>
        <span class="corner-link-aura"></span>
      </a>

      <a 
        href="#instagram" 
        class="workbench-corner-link corner-link-instagram" 
        title="Instagram профиль (в разработке)"
        aria-label="Instagram профиль GONKA.BLOG (в разработке)"
      >
        <svg class="corner-svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
          <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
        </svg>
        <span class="corner-link-tooltip">Instagram</span>
        <span class="corner-link-aura"></span>
      </a>

      <!-- ИНТЕРАКТИВНЫЕ ОБЪЕКТЫ НА СТОЛЕ -->

      <!-- 1. ВХОДЯЩИЙ (Винтажный красный телефон — точка прямой связи) -->
      <button type="button" class="hotspot hotspot-phone" data-target="modal-incoming" aria-label="Входящий: Есть задача? Давай обсудим">
        <div class="hotspot-aura"></div>
        <div class="phone-pulse-ring"></div>
        <div class="editorial-float-label label-switchboard-card label-below-left">
          <span class="editorial-tag">ПРЯМАЯ ЛИНИЯ</span>
          <span class="editorial-statement">«Есть задача? Снимем трубку.»</span>
        </div>
      </button>

      <!-- 2. ЧЕРНОВИК (Блокнот на спирали слева) -->
      <button type="button" class="hotspot hotspot-notebook" data-target="modal-draft" aria-label="Черновик лаборатории">
        <div class="hotspot-aura"></div>
        <div class="editorial-float-label label-draft-parchment label-above-left">
          <span class="parchment-tag">ЧЕРНОВИК // ЭСКИЗ</span>
          <span class="parchment-statement">«Сначала был один лист и карандаш.»</span>
        </div>
      </button>

      <!-- 3. НЕ ПОШЛО (Блокнот закрытых экспериментов) -->
      <button type="button" class="hotspot hotspot-failures" data-target="modal-failures" aria-label="Архив закрытых гипотез: НЕ ПОШЛО">
        <div class="hotspot-aura"></div>
        <div class="editorial-float-label label-failures-card label-above-left">
          <span class="editorial-tag tag-crimson-seal">АРХИВ ОШИБОК</span>
          <span class="editorial-statement">«Эту версию чуть не выбросил. Зато понял главное.»</span>
        </div>
      </button>

      <!-- 4. СВИТОК «САЙТЫ / ЛЕНДИНГИ» (ГОРИЗОНТАЛЬНЫЙ ФИЗИЧЕСКИЙ СВИТОК) -->
      <div 
        class="hotspot hotspot-scroll-sites physical-scroll-horizontal" 
        data-target="modal-sites" 
        role="button"
        tabindex="0"
        aria-label="Сайты / Лендинги: Каталог действующих веб-проектов"
        title="Сайты / Лендинги"
      >
        <!-- 1. Закрытый рулон (в исходном состоянии лежит на листе стола) -->
        <div class="sites-closed-wrapper">
          <img src="/svitok-closed.png" alt="Свиток Сайты / Лендинги (закрытый)" class="sites-closed-img" />
          <div class="sites-closed-tag">
            <span>САЙТЫ / ЛЕНДИНГИ</span>
          </div>
          <div class="sites-pulse-seal"></div>
        </div>

        <!-- 2. Развёрнутый свиток (плавно разворачивается по горизонтали в обе стороны влево и вправо) -->
        <div class="sites-unrolled-wrapper">
          <div class="scroll-roll-left">
            <div class="scroll-roll-finial finial-top"></div>
            <div class="scroll-roll-cylinder"></div>
            <div class="scroll-roll-finial finial-bottom"></div>
          </div>
          <div class="scroll-parchment-sheet">
            <div class="sites-parchment-content">
              <div class="sites-parchment-header">
                <span class="sites-parchment-tag">САЙТЫ / ЛЕНДИНГИ</span>
                <span class="sites-parchment-badge">6 РАБОТ</span>
              </div>

              <!-- Мини-меню проектов: клик сразу открывает персональное досье -->
              <div class="sites-screens-strip">
                <button 
                  type="button" 
                  class="sites-screen-chip" 
                  data-open-drawer="modal-english-teacher" 
                  title="English Teacher — открыть досье"
                  aria-label="English Teacher: открыть персональное досье проекта"
                >
                  <img src="/previews/preview-english-teacher.jpg" alt="English Teacher — первый экран" />
                  <span class="chip-label">ENG</span>
                </button>
                <button 
                  type="button" 
                  class="sites-screen-chip" 
                  data-open-drawer="modal-twohearts" 
                  title="TwoHearts — открыть досье"
                  aria-label="TwoHearts: открыть персональное досье проекта"
                >
                  <img src="/previews/preview-twohearts.jpg" alt="TwoHearts — первый экран" />
                  <span class="chip-label">2H</span>
                </button>
                <button 
                  type="button" 
                  class="sites-screen-chip" 
                  data-open-drawer="modal-siteviza" 
                  title="Siteviza — открыть досье"
                  aria-label="Siteviza: открыть персональное досье проекта"
                >
                  <img src="/previews/preview-siteviza.jpg" alt="Siteviza — первый экран" />
                  <span class="chip-label">VZN</span>
                </button>
                <button 
                  type="button" 
                  class="sites-screen-chip" 
                  data-open-drawer="modal-atelier" 
                  title="Atelier — открыть досье"
                  aria-label="Atelier: открыть персональное досье проекта"
                >
                  <img src="/previews/preview-atelier.jpg" alt="Atelier — первый экран" />
                  <span class="chip-label">ATL</span>
                </button>
                <button 
                  type="button" 
                  class="sites-screen-chip" 
                  data-open-drawer="modal-landasset5" 
                  title="LandAsset5 — открыть досье"
                  aria-label="LandAsset5: открыть персональное досье проекта"
                >
                  <img src="/previews/preview-landasset5.jpg" alt="LandAsset5 — первый экран" />
                  <span class="chip-label">LND</span>
                </button>
                <button 
                  type="button" 
                  class="sites-screen-chip" 
                  data-open-drawer="modal-tracker01" 
                  title="Tracker_01 — открыть досье"
                  aria-label="Tracker_01: открыть персональное досье проекта"
                >
                  <img src="/previews/preview-tracker01.jpg" alt="Tracker_01 — первый экран" />
                  <span class="chip-label">TRK</span>
                </button>
              </div>

              <div class="sites-parchment-sub">
                Каталог действующих проектов <span class="sites-arrow">➔</span>
              </div>
            </div>
            <div class="sites-wax-seal"></div>
          </div>
          <div class="scroll-roll-right">
            <div class="scroll-roll-finial finial-top"></div>
            <div class="scroll-roll-cylinder"></div>
            <div class="scroll-roll-finial finial-bottom"></div>
          </div>
        </div>
      </div>

      <!-- 5. СИСТЕМА // GONKA.BLOG (Центральный чертёж со связями) -->
      <button type="button" class="hotspot hotspot-core" data-target="modal-core" aria-label="GONKA.BLOG Система и Ядро">
        <div class="hotspot-aura"></div>
        <div class="editorial-float-label label-schematic-vellum label-above-center">
          <span class="editorial-tag">СИСТЕМА</span>
          <span class="editorial-statement">«Личная лаборатория. Всё собрано на одном столе.»</span>
        </div>
      </button>

      <!-- 6. СВИТОК «БОТЫ // TELEGRAM» (ФИЗИЧЕСКИЙ СВИТОК СО СМАРТФОНОМ ВНУТРИ) -->
      <div 
        class="hotspot hotspot-scroll-bots physical-scroll-bots" 
        data-target="modal-myasnaya-troitsa" 
        role="button"
        tabindex="0"
        aria-label="Боты: Telegram-боты лаборатории"
        title="Свиток ботов: Мясная Троица и Бот Детектив"
      >
        <!-- 1. Закрытый свиток (в исходном состоянии лежит на столе, телефон полностью скрыт внутри) -->
        <div class="bots-closed-wrapper">
          <img src="/svitok-closed.png" alt="Свиток Боты (закрытый)" class="bots-closed-img" />
          <div class="bots-closed-tag">
            <span>БОТЫ // TELEGRAM</span>
          </div>
          <div class="bots-pulse-seal"></div>
        </div>

        <!-- 2. Развёрнутый свиток (физически разворачивается, на нём лежит настоящий смартфон с работающими ботами) -->
        <div class="bots-unrolled-wrapper">
          <img 
            src="/svitok-bots-open.png" 
            alt="Раскрытый свиток с физическим смартфоном и Telegram-ботами" 
            class="bots-unrolled-img" 
          />
          
          <!-- Интерактивные кликабельные зоны поверх карточек ботов на экране смартфона -->
          <button 
            type="button" 
            class="phone-interactive-hotspot hotspot-meat" 
            data-open-drawer="modal-myasnaya-troitsa"
            title="Мясная Троица — открыть досье"
            aria-label="Мясная Троица: открыть персональное досье проекта"
          ></button>

          <button 
            type="button" 
            class="phone-interactive-hotspot hotspot-detective" 
            data-open-drawer="modal-aichatbot"
            title="Бот Детектив — открыть досье"
            aria-label="Бот Детектив: открыть персональное досье проекта"
          ></button>
        </div>
      </div>


      <!-- 8. ВИДЕО (35-мм киноплёнка монтажного стола) -->
      <button type="button" class="hotspot hotspot-video" data-target="modal-video" aria-label="Видео и монтаж">
        <div class="hotspot-aura"></div>
        <div class="editorial-float-label label-celluloid-strip label-above-filmstrip">
          <span class="editorial-tag">КИНОПЛЁНКА</span>
          <span class="editorial-statement">«От черновика до кадра.»</span>
        </div>
      </button>

      <!-- 9. ИНСТРУМЕНТЫ (Звёздная карта связей и технологий) -->
      <button type="button" class="hotspot hotspot-network" data-target="modal-network" aria-label="Инструменты: связи, технологии, инструменты">
        <div class="hotspot-aura"></div>
        <div class="editorial-float-label label-starchart-card label-above-center">
          <span class="editorial-tag tag-blue">ИНСТРУМЕНТЫ</span>
          <span class="editorial-statement">«Связи, стек и инструменты.»</span>
        </div>
      </button>

      <!-- 10. РЕЛОКАНТ СЕРБИЯ (Открытка — В РАБОТЕ) -->
      <button type="button" class="hotspot hotspot-serbia-wip" data-target="modal-serbia-wip" aria-label="Релокант Сербия: В работе">
        <div class="hotspot-aura"></div>
        <div class="editorial-float-label label-field-dispatch label-above-right">
          <span class="editorial-tag">РЕЛОКАНТ СЕРБИЯ</span>
          <span class="editorial-statement">«Полевое исследование и личный R&D.»</span>
        </div>
      </button>

      <!-- 11. СВИТОК «АВТОР» (Физический интерактивный свиток на столе) -->
      <button 
        type="button" 
        class="hotspot hotspot-scroll physical-scroll-object" 
        data-target="modal-about" 
        aria-label="Автор: «Хорошие идеи приходят не по расписанию.»"
      >
        <!-- 1. Закрытый рулон (в исходном состоянии лежит на столе) -->
        <div class="scroll-closed-wrapper">
          <img src="/svitok-closed.png" alt="Свиток Автор (закрытый)" class="scroll-closed-img" />
          <div class="scroll-closed-tag">
            <span>АВТОР</span>
          </div>
          <div class="scroll-pulse-seal"></div>
        </div>

        <!-- 2. Развёрнутый свиток (физически разворачивается в свободную зону при наведении) -->
        <div class="scroll-unrolled-wrapper">
          <img src="/svitok-open.png" alt="Развёрнутый свиток: Хорошие идеи приходят не по расписанию" class="scroll-open-img" />
        </div>
      </button>

      <!-- 12. КРУЖКА «IDEAS BUILD TEST REPEAT» -->
      <button type="button" class="hotspot hotspot-mug" data-target="modal-manifesto" aria-label="Манифест действия: IDEAS BUILD TEST REPEAT">
        <div class="hotspot-aura"></div>
        <div class="editorial-float-label label-coaster-tile label-above-right">
          <span class="editorial-tag">IDEAS BUILD TEST REPEAT</span>
          <span class="editorial-statement">«Меньше теории — больше работающих вещей.»</span>
        </div>
      </button>

      <!-- 13. ПРАВАЯ ВЕРТИКАЛЬНАЯ НАВИГАЦИЯ (ОГЛАВЛЕНИЕ СТОЛА ИЗ 8 ОСНОВНЫХ РАЗДЕЛОВ) -->
      <nav class="cabinet-menu-nav" aria-label="Оглавление интерактивного стола">
        <div class="cabinet-nav-backdrop" aria-hidden="true"></div>

        <!-- 1. ЧЕРНОВИК -->
        <button type="button" class="hotspot cabinet-nav-item" data-target="modal-draft" aria-label="Черновик: открыть лабораторные записи и эскизы">
          <span class="cabinet-nav-label">ЧЕРНОВИК</span>
        </button>

        <!-- 2. ЛЕНДИНГИ -->
        <button type="button" class="hotspot cabinet-nav-item" data-target="modal-sites" aria-label="Лендинги: открыть каталог действующих веб-проектов">
          <span class="cabinet-nav-label">ЛЕНДИНГИ</span>
        </button>

        <!-- 3. СИСТЕМА -->

    transition: opacity 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    pointer-events: none;
  }

  .workbench-corner-link:hover .corner-link-aura {
    opacity: 1;
    border-color: rgba(245, 158, 11, 0.6);
    box-shadow: 0 0 12px rgba(245, 158, 11, 0.35), inset 0 0 8px rgba(245, 158, 11, 0.15);
  }

  .workbench-corner-link:hover {
    transform: scale(1.08);
  }

  /* Accessibility screen-reader only utility */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  /* ИНТЕРАКТИВНЫЕ ХОТСПОТЫ */
  .hotspot {
    position: absolute;
    cursor: pointer;
    background: transparent;
    border: none;
    padding: 0;
    transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 20;
    outline: none;
  }

  .hotspot-aura {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    opacity: 0;
    transition: opacity 0.25s ease, box-shadow 0.25s ease;
    pointer-events: none;
  }

  .hotspot:hover .hotspot-aura,
  .hotspot.is-hovered .hotspot-aura {
    opacity: 1;
    box-shadow: 0 0 20px rgba(249, 115, 22, 0.4), inset 0 0 10px rgba(249, 115, 22, 0.15);
  }

  /* 1. ТЕЛЕФОН */
  .hotspot-phone {
    top: 3.5%;
    left: 0.8%;
    width: 16.0%;
    height: 18.5%;
    border-radius: 16px;
  }

  /* СЛОТ 5: ЛУПА */
  .hotspot-slot-magnifier {
    top: 21.0%;
    left: 4.5%;
    width: 20.0%;
    height: 12.5%;
    border-radius: 20px;
  }
  .phone-pulse-ring {
    position: absolute;
    top: 22%;
    left: 48%;
    width: 32px;
    height: 32px;
    border-radius: 9999px;
    border: 2px solid rgba(249, 115, 22, 0.6);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .hotspot-phone:hover .phone-pulse-ring,
  .hotspot-phone.is-hovered .phone-pulse-ring {
    opacity: 1;
    animation: ping 1.4s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  /* 2. БЛОКНОТ СЛЕВА */
  .hotspot-notebook {
    top: 34.0%;
    left: 2.0%;
    width: 22.0%;
    height: 29.5%;
    border-radius: 10px;
    border: 1px dashed transparent;
  }
  .hotspot-notebook:hover,
  .hotspot-notebook.is-hovered {
    border-color: rgba(245, 158, 11, 0.5);
    transform: translateY(-2px);
  }

  /* 3. НЕ ПОШЛО */

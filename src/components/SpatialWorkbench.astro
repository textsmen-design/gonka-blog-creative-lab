  .workbench-frame {
    position: relative;
    z-index: 10;
    width: 100vw;
    max-width: 100vw;
    height: calc(100vw * 971 / 1619);
    aspect-ratio: 1619 / 971;
    flex-shrink: 0;
    margin: 0;
    overflow: hidden;
  }

  .workbench-bg-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: fill;
    pointer-events: none;
  }

  .workbench-light-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;

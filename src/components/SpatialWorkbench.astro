    box-shadow: 0 0 10px rgba(255, 190, 90, 0.25), inset 0 1px 3px rgba(0, 0, 0, 0.6);
  }
  .pill-side { position: absolute; top: 0; bottom: 0; width: 50%; display: grid; place-items: center; z-index: 2; transition: color 0.6s ease, opacity 0.6s ease; }
  .pill-side svg { width: 16px; height: 16px; }
  .pill-sun { left: 0; color: #3a2400; }
  .pill-moon { right: 0; color: #9db4e8; }
  .pill-knob {
    position: absolute; top: 2px; left: 2px; width: 30px; height: 22px; border-radius: 999px; z-index: 1;
    background: radial-gradient(circle at 40% 35%, #fff4cf 0%, #ffc857 60%, #f29a2e 100%);
    box-shadow: 0 0 12px rgba(255, 190, 80, 0.8);
    transition: transform 0.6s cubic-bezier(0.5, 0, 0.2, 1), background 0.6s ease, box-shadow 0.6s ease;
  }
  :global([data-theme="night"]) .pill-knob { transform: translateX(28px); background: radial-gradient(circle at 40% 35%, #ffffff 0%, #cfdcff 60%, #8ea6e0 100%); box-shadow: 0 0 12px rgba(160, 190, 255, 0.8); }
  :global([data-theme="night"]) .pill-sun { color: #c9a35a; }

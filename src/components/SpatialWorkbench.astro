    text-transform: uppercase;
  }

  .dossier-screen-caption .caption-dot {
    color: #22c55e;
    font-size: 8px;
    animation: pulse 2s infinite;
  }

  /* ДВУХКОЛОНОЧНАЯ СЕТКА */
  .case-grid {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .workbench-drawer.is-expanded .case-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }
  .case-col-left, .case-col-right { min-width: 0; }
  /* узкий экран: развёрнутая запись в одну колонку (две колонки обрезались справа) */
  @media (max-width: 860px) {
    .workbench-drawer.is-expanded .case-grid { grid-template-columns: minmax(0, 1fr); gap: 18px; }
  }

  .case-section {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .section-heading {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11.5px;
    font-weight: 700;
    color: #f97316;
    letter-spacing: 0.06em;
    margin-bottom: 4px;
  }

  .section-text {
    font-size: 14.5px;
    line-height: 1.6;
    color: #e7e5e4;
  }

  .facts-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .facts-list li {
    position: relative;
    padding-left: 18px;
    font-size: 14px;
    line-height: 1.55;
    color: #e7e5e4;
  }
  .facts-list li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: #ea580c;
    font-weight: 700;
    font-size: 16px;
    line-height: 1.2;
  }

  .tech-spec-box {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 12px 14px;
    border-radius: 8px;
    background: rgba(12, 10, 8, 0.55);
    border: 1px solid rgba(245, 158, 11, 0.15);
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
  }

  .spec-row {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    padding: 4px 0;
    border-bottom: 1px dashed rgba(245, 158, 11, 0.1);
  }
  .spec-row:last-child { border-bottom: none; }
  .spec-row span { color: #c2bcb2; }
  .spec-row strong { color: #ffffff; text-align: right; }

  .result-status-box {
    padding: 12px 14px;
    border-radius: 8px;
    background: rgba(52, 211, 153, 0.08);
    border: 1px solid rgba(52, 211, 153, 0.25);
    font-size: 13.5px;
    line-height: 1.55;
    color: #a7f3d0;
  }

  .quote-box {
    margin: 0;
    padding: 14px 16px;
    border-left: 3px solid #f97316;
    background: rgba(249, 115, 22, 0.08);
    border-radius: 0 8px 8px 0;
    font-family: 'Caveat', cursive;
    font-size: 20px;
    line-height: 1.35;
    color: #fed7aa;
  }

  .failures-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .failure-item {
    padding: 14px;
    border-radius: 8px;
    background: rgba(239, 68, 68, 0.08);
    border: 1px solid rgba(239, 68, 68, 0.2);
  }
  .failure-title {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    font-weight: 700;
    color: #fca5a5;
  }
  .failure-desc {
    font-size: 13.5px;
    line-height: 1.55;
    color: #ded9d1;
    margin-top: 6px;
  }

  .rules-stack {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .rule-card {
    display: flex;
    gap: 14px;
    padding: 14px;
    border-radius: 8px;
    background: rgba(25, 21, 17, 0.6);
    border: 1px solid rgba(245, 158, 11, 0.14);
  }
  .rule-num {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 20px;
    font-weight: 700;
    color: #f97316;
    line-height: 1;
  }
  .rule-content strong {
    display: block;
    font-size: 15px;
    color: #ffffff;
    margin-bottom: 4px;
  }
  .rule-content p {
    font-size: 13.5px;
    line-height: 1.55;
    color: #d1cbc1;
    margin: 0;
  }

  /* АРТЕФАКТЫ РАЗДЕЛА «ОБО МНЕ» (ЛАБОРАТОРНЫЙ СТИЛЬ) */
  .lab-dossier-card {
    padding: 16px 18px;
    border-radius: 8px;
    background: rgba(28, 23, 18, 0.65);
    border: 1px solid rgba(245, 158, 11, 0.18);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .dossier-badge-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.08em;
    color: #a8a29e;
    padding-bottom: 6px;
    border-bottom: 1px dashed rgba(255, 255, 255, 0.08);
  }
  .dossier-tag {
    color: #f97316;
    font-weight: 700;
  }
  .dossier-status {
    color: #34d399;
    font-weight: 600;
  }
  .dossier-block {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .author-greeting {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 18px;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.01em;
  }
  .dossier-subheading {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    font-weight: 700;
    color: #f59e0b;
    letter-spacing: 0.08em;
  }
  .dossier-text {
    font-size: 14px;
    line-height: 1.55;
    color: #e7e5e4;
    margin: 0;
  }
  .dossier-divider {
    height: 1px;
    border-top: 1px dashed rgba(255, 255, 255, 0.07);
    margin: 2px 0;
  }

  .lab-artifact-card {
    padding: 14px 16px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .lab-artifact-card:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(249, 115, 22, 0.3);
  }

  .lab-card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.08em;
    color: #a8a29e;
    border-bottom: 1px dashed rgba(255, 255, 255, 0.08);
    padding-bottom: 6px;
    margin-bottom: 2px;
  }
  .lab-card-id {
    color: #f97316;
    font-weight: 700;
  }
  .lab-card-status {
    color: #34d399;
    font-weight: 600;
  }

  .greeting-highlight {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .greeting-accent {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 17px;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.01em;
  }

  .lab-card-terms {
    position: relative;
    border-left: 3px solid #f59e0b;
    background: rgba(245, 158, 11, 0.05);
  }

  /* ВИЗУАЛЬНЫЙ АРТЕФАКТ СВИТКА */
  .lab-scroll-artifact {
    position: relative;
    padding: 16px 18px;
    border-radius: 10px;
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.08) 0%, rgba(28, 25, 23, 0.85) 100%);
    border: 1px solid rgba(245, 158, 11, 0.3);
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5), inset 0 0 25px rgba(245, 158, 11, 0.04);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .scroll-artifact-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .wax-seal-icon {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .seal-core {
    width: 10px;
    height: 10px;
    border-radius: 9999px;
    background: radial-gradient(circle at 35% 35%, #ef4444 0%, #991b1b 100%);
    box-shadow: 0 0 8px rgba(239, 68, 68, 0.55), inset 0 0 2px rgba(255, 255, 255, 0.5);
    display: inline-block;
  }
  .seal-text {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px;
    font-weight: 700;
    color: #fca5a5;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .scroll-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px;
    color: #f59e0b;
    opacity: 0.85;
  }

  .scroll-handwritten-text {
    margin: 0;
    padding: 4px 0;
    font-family: 'Caveat', 'Literata', 'Georgia', cursive, serif;
    font-size: 21px;
    line-height: 1.35;
    color: #fef08a;
    text-shadow: 0 0 12px rgba(245, 158, 11, 0.25);
    font-weight: 600;
  }

  .scroll-artifact-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 8px;
    border-top: 1px dashed rgba(245, 158, 11, 0.2);
    font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px;
    color: #a8a29e;
    letter-spacing: 0.06em;
  }
  .artifact-signature {
    color: #fed7aa;
  }

  /* БЭКДРОП */
  .drawer-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(14px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
    z-index: 55;
  }
  .drawer-backdrop.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  /* Верхняя панель: время, пояс и координаты без скачков ширины */
  .meta-coords { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .meta-tz { display: inline-block; min-width: 4.5ch; color: #a8a29e; }
  .meta-geo { display: inline-flex; align-items: baseline; gap: 6px; }
  #live-coords { display: inline-block; min-width: 16ch; }
  .meta-geo { position: relative; }
  .geo-btn { font: 600 9px/1 'JetBrains Mono', monospace; letter-spacing: 0.06em; text-transform: uppercase; color: #d6c9b0; background: transparent; border: 1px solid rgba(255, 214, 150, 0.35); border-radius: 999px; padding: 3px 0; width: 84px; text-align: center; cursor: pointer; transition: border-color 0.2s ease, color 0.2s ease; }
  .geo-btn:hover, .geo-btn:focus-visible { color: #fff; border-color: #ffb84d; outline: none; }
  .geo-btn:disabled { opacity: 0.6; cursor: progress; }
  .geo-btn[hidden] { display: none; }
  .geo-hint { position: absolute; left: 0; top: calc(100% + 10px); z-index: 80; width: 330px; padding: 8px 10px; white-space: normal; font: 500 11px/1.4 'Space Grotesk', system-ui, sans-serif; letter-spacing: 0; text-transform: none; color: #2b180d; background: linear-gradient(135deg, #f6ebd2 0%, #dcc397 100%); border: 1px solid rgba(120, 75, 30, 0.55); border-radius: 4px; box-shadow: 0 6px 16px rgba(0, 0, 0, 0.5); opacity: 0; transform: translateY(-4px); pointer-events: none; transition: opacity 0.2s ease, transform 0.2s ease; }
  .meta-geo:hover .geo-hint, .meta-geo:focus-within .geo-hint, .geo-hint.is-shown { opacity: 1; transform: none; }
  [data-state="granted"] #live-coords { color: #e7f5d9; }
  .meta-src { display: inline-block; width: 98px; font-style: normal; font-size: 9px; letter-spacing: 0.06em; text-transform: uppercase; color: #78716c; }

  /* адрес почты в строках параметров — ссылка mailto: без изменения вида (цвет и начертание наследуются) */
  .mail-link { color: inherit; text-decoration: none; }
  .mail-link:hover, .mail-link:focus-visible { text-decoration: underline; text-underline-offset: 3px; outline: none; }
  /* ---- фото автора и фото Белграда в панелях ---- */
  .author-portrait, .srbija-photo { margin: 0; position: relative; }
  .author-portrait img, .srbija-photo img { display: block; width: 100%; height: auto; object-fit: cover; }
  .author-portrait {
    width: min(190px, 46%); aspect-ratio: 3 / 4; border-radius: 10px; overflow: hidden;
    border: 1px solid rgba(245, 158, 11, 0.38);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.55), inset 0 0 0 1px rgba(255, 255, 255, 0.05);
  }
  .author-portrait img { height: 100%; object-position: 50% 22%; }
  .author-portrait::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(180deg, transparent 62%, rgba(10, 6, 3, 0.35) 100%); }
  .drawer-about .case-hero-strip { display: grid; grid-template-columns: minmax(0, 1fr); row-gap: 12px; }
  .drawer-about .case-hero-strip > .author-portrait { margin-bottom: 4px; }
  .author-hero-text { display: grid; row-gap: 12px; min-width: 0; align-content: start; }
  .author-wide { display: none; margin: 0; position: relative; }
  /* Развёрнутая запись: кадр avtor.png целиком (3:2) справа от текста; левый край растворяется в фоне панели, фото «стоит» на том же столе */
  .workbench-drawer.is-expanded.drawer-about .case-hero-strip { grid-template-columns: minmax(0, 1fr) clamp(300px, 36%, 420px); column-gap: 32px; align-items: center; }
  .workbench-drawer.is-expanded.drawer-about .case-hero-strip > .author-portrait { display: none; }
  .workbench-drawer.is-expanded.drawer-about .case-hero-strip > .author-wide { display: block; grid-column: 2; grid-row: 1; aspect-ratio: 3 / 2; border-radius: 12px; overflow: hidden; border: 1px solid rgba(245, 158, 11, 0.32); box-shadow: 0 14px 34px rgba(0, 0, 0, 0.55), 0 0 40px rgba(245, 158, 11, 0.10); }
  .workbench-drawer.is-expanded.drawer-about .case-hero-strip > .author-hero-text { grid-column: 1; grid-row: 1; row-gap: 10px; }
  /* без лишних воздушных зазоров: иерархия «метка → заголовок → описание → кнопки» сохранена, но плотнее */
  .workbench-drawer.is-expanded.drawer-about .author-hero-text > .case-title { margin: 0; }
  .workbench-drawer.is-expanded.drawer-about .author-hero-text > .case-lead { margin: 0; }
  .workbench-drawer.is-expanded.drawer-about .author-hero-text > .case-actions { margin-top: 8px; }
  .author-wide img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 50%; }
  .author-wide::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(90deg, rgba(23, 20, 18, 0.55) 0%, transparent 22%), linear-gradient(0deg, rgba(23, 20, 18, 0.30) 0%, transparent 28%); }
  /* узкий экран: фото над текстом, во всю ширину */
  @media (max-width: 860px) {
    .workbench-drawer.is-expanded.drawer-about .case-hero-strip { grid-template-columns: minmax(0, 1fr); row-gap: 14px; }
    .workbench-drawer.is-expanded.drawer-about .case-hero-strip > .author-wide { grid-column: 1; grid-row: 1; width: 100%; max-width: 620px; }   /* естественные пропорции 3:2, лицо не обрезается */
    .workbench-drawer.is-expanded.drawer-about .case-hero-strip > .author-hero-text { grid-row: 2; }
  }
  .srbija-photo { aspect-ratio: 16 / 9; max-height: 340px; border-radius: 10px; overflow: hidden; margin: 0 0 16px; border: 1px solid rgba(245, 158, 11, 0.38); box-shadow: 0 10px 28px rgba(0, 0, 0, 0.5); }
  .srbija-photo img { height: 100%; object-position: 50% 45%; }
  .workbench-drawer.is-expanded .srbija-photo { aspect-ratio: 21 / 8; max-height: 300px; }
  @media (max-width: 520px) { .author-portrait { width: min(150px, 44%); } }

  /* ==================================================
     СЦЕНА v2: стол у окна, предметы-объекты, день/ночь
     Контуры предметов: src/scene/objects.mjs
     ================================================== */
  .scene-frame.workbench-frame {
    --menu-w: clamp(132px, 10vw, 168px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--menu-w);
    width: 100vw;
    max-width: 100vw;
    height: calc(100svh - 42px);
    min-height: 520px;
    aspect-ratio: auto;
    background: #0d0907;
    overflow: hidden;
  }

  .scene-clip {
    position: relative;
    overflow: hidden;
    container-type: size;
    min-width: 0;
  }

  .scene-stage {
    --k: 1;
    --scene-img: url('/scene/day.jpg');
    position: absolute;
    left: 50%;
    top: 50%;
    width: max(100cqw, calc(100cqh * 1672 / 940));
    aspect-ratio: 1672 / 940;
    translate: -47% -50%;
    user-select: none;
    -webkit-user-select: none;
  }
  :global([data-theme="night"]) .scene-stage { --scene-img: url('/scene/night.jpg'); }

  .scene-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
    -webkit-user-drag: none;
  }
  .scene-bg-night { opacity: 0; transition: opacity 1.4s ease; }
  :global([data-theme="night"]) .scene-bg-night { opacity: 1; }

  /* ---- свет сцены ---- */
  .scene-fx { position: absolute; inset: 0; pointer-events: none; transition: opacity 1.4s ease; }
  .scene-fx-sun {
    background: radial-gradient(ellipse 36% 44% at 45.4% 25.5%, rgba(255, 220, 150, 0.6) 0%, rgba(255, 170, 70, 0.2) 45%, transparent 74%);
    mix-blend-mode: screen; opacity: 0.55;
  }
  .scene-fx-rays {
    background: repeating-conic-gradient(from 0deg at 45.4% 25.5%, rgba(255, 228, 165, 0.22) 0deg 2.6deg, transparent 2.6deg 13deg);
    -webkit-mask-image: radial-gradient(ellipse 50% 78% at 45.4% 25.5%, #000 0%, rgba(0, 0, 0, 0.35) 30%, transparent 62%);
    mask-image: radial-gradient(ellipse 50% 78% at 45.4% 25.5%, #000 0%, rgba(0, 0, 0, 0.35) 30%, transparent 62%);
    mix-blend-mode: screen; opacity: 0.5;
    animation: scene-rays 9s ease-in-out infinite alternate;
  }
  @keyframes scene-rays { from { opacity: 0.32; } to { opacity: 0.62; } }
  .scene-fx-moon {
    background:
      radial-gradient(ellipse 26% 38% at 56.5% 43%, rgba(160, 195, 255, 0.42) 0%, rgba(90, 120, 220, 0.14) 45%, transparent 75%),
      radial-gradient(ellipse 48% 22% at 52% 74%, rgba(110, 150, 255, 0.12) 0%, transparent 70%);
    mix-blend-mode: screen; opacity: 0;
  }
  .scene-fx-lamp {
    background:
      radial-gradient(ellipse 20% 34% at 13.4% 37%, rgba(255, 205, 120, 0.7) 0%, rgba(255, 150, 60, 0.26) 45%, transparent 76%),
      radial-gradient(ellipse 34% 30% at 17% 70%, rgba(255, 170, 80, 0.2) 0%, transparent 70%);
    mix-blend-mode: screen; opacity: 0.16;
  }
  .scene-fx-stars { opacity: 0; }
  .scene-fx-stars span { position: absolute; border-radius: 50%; background: #fff; box-shadow: 0 0 4px rgba(200, 220, 255, 0.9); animation: scene-twinkle 4.6s ease-in-out infinite; }
  @keyframes scene-twinkle { 0%, 100% { opacity: 0.25; } 50% { opacity: 1; } }
  .scene-fx-vignette { background: radial-gradient(ellipse 88% 92% at 50% 52%, transparent 58%, rgba(10, 5, 2, 0.5) 100%); }

  :global([data-theme="night"]) .scene-fx-sun,
  :global([data-theme="night"]) .scene-fx-rays { opacity: 0; animation: none; }
  :global([data-theme="night"]) .scene-fx-moon { opacity: 1; }
  :global([data-theme="night"]) .scene-fx-stars { opacity: 1; }
  :global([data-theme="night"]) .scene-fx-lamp { opacity: 0.95; animation: scene-lamp 6s ease-in-out infinite alternate; }
  @keyframes scene-lamp { from { opacity: 0.86; } to { opacity: 1; } }

  /* ---- предметы ---- */
  .scene-obj { position: absolute; pointer-events: none; --lift: 7px; --pop: 1.035; --tilt: 0deg; }
  .scene-obj.kind-big { --lift: 4px; --pop: 1.012; }
  .scene-obj.kind-flat { --lift: 0px; --pop: 1; }

  .obj-hit {
    position: absolute; inset: 0; width: 100%; height: 100%;
    margin: 0; padding: 0; border: 0; background: transparent;
    cursor: pointer; pointer-events: auto;
    -webkit-tap-highlight-color: transparent; outline: none;
  }
  .obj-lift {
    position: absolute; inset: 0; pointer-events: none;
    opacity: 0;
    transform-origin: 50% 78%;
    transition: transform 0.34s cubic-bezier(0.2, 0.8, 0.2, 1), filter 0.34s ease, opacity 0s linear 0.36s;
  }
  .obj-art { position: absolute; inset: 0; background-image: var(--scene-img); background-repeat: no-repeat; }

  @media (hover: hover) {
    .obj-hit:hover + .obj-lift {
      opacity: 1;
      transition: transform 0.34s cubic-bezier(0.2, 0.8, 0.2, 1), filter 0.34s ease, opacity 0s;
      transform: translate3d(0, calc(var(--lift) * -1), 0) scale(var(--pop)) rotate(var(--tilt));
      filter: drop-shadow(0 calc(var(--lift) * 1.9) calc(var(--lift) * 1.5) rgba(0, 0, 0, 0.5)) brightness(1.1) saturate(1.1);
    }
    .scene-obj.kind-flat .obj-hit:hover + .obj-lift {
      transform: none;
      filter: brightness(1.13) saturate(1.12) drop-shadow(0 0 10px rgba(255, 200, 120, 0.5));
    }
    .obj-hit:hover ~ .obj-tip { opacity: 1; transform: translate(calc(-50% + var(--tip-dx, 0px)), calc(-100% - 8px)); }
  }
  .obj-hit:focus-visible + .obj-lift {
    opacity: 1;
    transition: transform 0.34s cubic-bezier(0.2, 0.8, 0.2, 1), filter 0.34s ease, opacity 0s;
    transform: translate3d(0, calc(var(--lift) * -1), 0) scale(var(--pop)) rotate(var(--tilt));
    filter: drop-shadow(0 0 2px #ffe3a1) drop-shadow(0 0 7px rgba(255, 184, 77, 0.95)) drop-shadow(0 calc(var(--lift) * 1.9) calc(var(--lift) * 1.5) rgba(0, 0, 0, 0.5)) brightness(1.1);
  }
  .obj-hit:focus-visible ~ .obj-tip { opacity: 1; transform: translate(calc(-50% + var(--tip-dx, 0px)), calc(-100% - 8px)); }
  .obj-hit:active + .obj-lift {
    opacity: 1;
    transition-duration: 0.08s;
    transform: translate3d(0, calc(var(--lift) * -0.25), 0) scale(1.005);
    filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.55)) brightness(0.96);
  }

  .obj-tip {
    position: absolute; left: 50%; top: 0;
    transform: translate(calc(-50% + var(--tip-dx, 0px)), calc(-100% - 2px));
    opacity: 0; pointer-events: none; white-space: nowrap;
    display: flex; flex-direction: column; gap: 1px;
    padding: 5px 10px 6px;

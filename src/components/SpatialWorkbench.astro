  /* ПОЗИЦИОНИРОВАНИЕ АРТЕФАКТОВ ПО ОТНОШЕНИЮ К ПРЕДМЕТАМ */
  .label-below-left {
    bottom: -36px;
    left: 10px;
    transform: translateY(6px);
  }
  .label-above-left {
    top: -42px;
    left: 10px;
    transform: translateY(-6px);
  }
  .label-above-center {
    top: -42px;
    left: 50%;
    transform: translate(-50%, -6px);
  }
  .label-above-right {
    top: -42px;
    right: 10px;
    transform: translateY(-6px);
  }
  .label-above-filmstrip {
    top: -42px;
    left: 20px;
    transform: translateY(-6px);
  }
  .label-left-side {
    top: 50%;
    right: calc(100% + 12px);
    transform: translateY(-50%) translateX(6px);
  }

  .hotspot:hover .editorial-float-label,
  .hotspot.is-hovered .editorial-float-label {
    opacity: 1;
    transform: translate(0, 0);
  }
  .hotspot-notebook:hover .label-draft-parchment,
  .hotspot-notebook.is-hovered .label-draft-parchment {
    transform: rotate(-2.2deg) translateY(0);
  }
  .hotspot-failures:hover .label-failures-card,
  .hotspot-failures.is-hovered .label-failures-card {
    transform: rotate(1.5deg) translateY(0);
  }
  .hotspot-serbia-wip:hover .label-field-dispatch,
  .hotspot-serbia-wip.is-hovered .label-field-dispatch {
    transform: rotate(-1.2deg) translateY(0);
  }
  .hotspot-core:hover .editorial-float-label,
  .hotspot-core.is-hovered .editorial-float-label {
    transform: translate(-50%, 0);
  }


  /* НИЖНЯЯ ПАНЕЛЬ */

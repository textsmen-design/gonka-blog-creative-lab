---
// src/components/SpatialWorkbench.astro
import site from '../data/site.json';
import links from '../data/links.json';
import media from '../data/media.json';
import sections from '../data/sections.json';
import projects from '../data/projects.json';
import scene from '../data/scene.json';
import { objects as sceneObjects, geometry as sceneGeometry } from '../scene/objects.mjs';

const S = sections;
// L.<id> для кнопок разделов берётся из links.socials[] (единый источник), остальные ссылки — из links.*
const L: any = { ...links, ...Object.fromEntries(links.socials.map((x: any) => [x.id, x.url])) };
const socials = L.socials;
const M = media.previews;
// проекты из архива (status: archived) на публичный сайт не попадают
const P: any = { ...projects, landings: projects.landings.filter((x: any) => x.status !== 'archived'), trackers: projects.trackers.filter((x: any) => x.status !== 'archived'), bots: projects.bots.filter((x: any) => x.status !== 'archived') };
const W0 = "\n";
const W1 = " ";

const slotLamp = P.slots.find((s) => s.slotId === 'lamp');
const slotMug = P.slots.find((s) => s.slotId === 'mug');
const slotCompass = P.slots.find((s) => s.slotId === 'compass');
const slotPhotos = P.slots.find((s) => s.slotId === 'photos');
const slotMagnifier = P.slots.find((s) => s.slotId === 'magnifier');
const slotPencilcup = P.slots.find((s) => s.slotId === 'pencilcup');
const primaryTracker = P.trackers?.[0];
// Адрес почты в строках параметров панелей «Автор» и «Связь» — тот же текст из данных, но ссылкой mailto:
const aboutMail = S['modal-about'].blocks[2].specs[4][1];
const incomingMail = S['modal-incoming'].blocks[1].specs[1][1];
const isMail = (v: string) => /^[^\s@]+@[^\s@]+\.[A-Za-z]{2,}$/.test(v);
// Широкое фото автора (кадр avtor.png целиком) для развёрнутой записи; боковая панель использует M.authorPortrait
const AUTHOR_WIDE = '/previews/author-wide.jpg';
// кнопки на экране телефона свитка «Боты» (картинка содержит две карточки) работают только для опубликованных ботов
const botDrawers = new Set(P.bots.filter((b: any) => b.status === 'published').map((b: any) => b.drawerId));

// --- Новая сцена: предметы стола (контуры — src/scene/objects.mjs) ---
const slotById: Record<string, any> = {
  lamp: slotLamp, mug: slotMug, compass: slotCompass,
  photos: slotPhotos, magnifier: slotMagnifier, pencilcup: slotPencilcup,
};
const deskTips: Record<string, { tag: string; statement: string }> = site.desk;
const zByKind: Record<string, number> = { flat: 1, big: 2, object: 3 };
const geometryById: Record<string, any> = Object.fromEntries(sceneObjects.map((o: any) => [o.id, o]));
// Порядок и видимость предметов — scene.json; форма и физика — src/scene/objects.mjs
const sceneItems = scene.items
  .map((cfg: any, order: number) => ({ cfg, geo: geometryById[cfg.id], order }))
  .filter((x: any) => x.geo && x.cfg.visible)
  .map(({ cfg, geo, order }: any) => {
    const slot = geo.slot ? slotById[geo.slot] : null;
    const published = !!(slot?.assigned && slot?.project?.status === 'published');
    const desk = cfg.tipKey ? deskTips[cfg.tipKey] : null;
    return {
      ...geo,
      target: cfg.target,
      label: cfg.label,
      g: sceneGeometry(geo),
      z: zByKind[geo.kind] * 100 + order,
      tip: published ? (slot.project.badge || 'ПРОЕКТ') : (desk?.tag || ''),
      sub: published ? slot.project.name : (desk?.statement || ''),
      aria: published ? slot.project.name : (desk ? `${desk.tag}: ${desk.statement}` : `Резервный слот: ${cfg.label}`),
    };
  }).sort((a: any, b: any) => a.z - b.z);

// Звёзды ночного окна (детерминированно, без Math.random — сборка воспроизводима)
let seed = 11;
const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
const stars = Array.from({ length: 34 }, () => ({
  x: +(26 + rnd() * 62).toFixed(2), y: +(1.5 + rnd() * 25).toFixed(2),
  s: +(1.2 + rnd() * 1.8).toFixed(1), d: +(rnd() * 6).toFixed(1),
}));
---

<div id="spatial-canvas-container" class="spatial-root select-none">

  <!-- ВЕРХНЯЯ РАМА ВЕРСТАКА -->
  <header class="desk-topbar">
    
    <!-- Левая группа: Статус лаборатории и время -->
    <div class="topbar-left">
      <div class="status-pill">
        <span class="live-pulse-wrapper">
          <span class="pulse-ring"></span>
          <span class="pulse-dot"></span>
        </span>
        <span class="status-text">{site.topbar.status}</span>
      </div>

      <div class="meta-coords">
        <span title="Время и часовой пояс вашего устройства">ВРЕМЯ: <strong id="live-clock">--:--:--</strong> <span id="live-tz" class="meta-tz"></span></span>
        <span>•</span>
        <span class="meta-geo" id="live-geo" data-state="idle">
          <span id="live-coords" data-source="author" title="Координаты авторской точки">45°15′N 19°51′E</span>
          <em id="live-coords-src" class="meta-src">авторская точка</em>
          <button type="button" id="geo-btn" class="geo-btn" aria-describedby="geo-hint">определить</button>
          <span id="geo-hint" class="geo-hint" role="status" aria-live="polite">Определить ваше местоположение? Браузер спросит разрешение. Координаты остаются только в вашем браузере: не сохраняются и никуда не отправляются.</span>
        </span>
        <span>•</span>
        <span>{site.topbar.vibe}</span>
      </div>
    </div>

    <!-- Правая группа: Тумблер освещения + Соцсети/Связь -->
    <div class="topbar-right">
      <button id="desk-theme-toggle" class="theme-btn theme-pill" type="button" role="switch" aria-checked="false" aria-label="Ночной режим" title="Переключить день и ночь">
        <span class="pill-side pill-sun" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4.2" fill="currentColor"/><path d="M12 2.5v2.6M12 18.9v2.6M2.5 12h2.6M18.9 12h2.6M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8"/></svg></span>
        <span class="pill-side pill-moon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.5 14.6A8.6 8.6 0 0 1 9.4 3.5a8.6 8.6 0 1 0 11.1 11.1Z"/></svg></span>
        <span class="pill-knob" aria-hidden="true"></span>
        <span id="desk-theme-icon" hidden>☼</span>
        <span id="desk-theme-label" class="sr-only">ДЕНЬ</span>
      </button>
    </div>

  </header>

  <!-- ЦЕНТРАЛЬНЫЙ СВЕТОВОЙ СТОЛ (сцена v2: окно, стол, предметы-объекты; день/ночь) -->
  <main class="workbench-viewport">

    <div id="workbench-canvas" class="workbench-frame scene-frame">
      <div class="scene-clip">
        <div id="scene-stage" class="scene-stage">

          <img src="/scene/day.jpg" alt="GONKA.BLOG: деревянный рабочий стол у окна с видом на залив" class="scene-bg scene-bg-day" width="1672" height="940" decoding="async" fetchpriority="high" />
          <img src="/scene/night.jpg" alt="" aria-hidden="true" class="scene-bg scene-bg-night" width="1672" height="940" decoding="async" />

          <!-- Свет сцены: солнце днём, луна и лампа ночью -->
          <div class="scene-fx scene-fx-sun" aria-hidden="true"></div>
          <div class="scene-fx scene-fx-rays" aria-hidden="true"></div>
          <div class="scene-fx scene-fx-moon" aria-hidden="true"></div>
          <div class="scene-fx scene-fx-lamp" aria-hidden="true"></div>
          <div class="scene-fx scene-fx-stars" aria-hidden="true">
            {stars.map((st: any) => <span style={`left:${st.x}%;top:${st.y}%;width:${st.s}px;height:${st.s}px;animation-delay:${st.d}s`}></span>)}
          </div>
          <div class="scene-fx scene-fx-vignette" aria-hidden="true"></div>

          <!-- ПРЕДМЕТЫ: каждая кнопка вырезана по контуру предмета; «приподнимается» копия именно этой области фона -->
          {sceneItems.map((it: any) => (
            <div class={`scene-obj kind-${it.kind}`} data-obj={it.id}
              style={`left:${it.g.left}%;top:${it.g.top}%;width:${it.g.width}%;height:${it.g.height}%;z-index:${it.z};--tilt:${it.tilt}deg`}>
              <button type="button" class="obj-hit" data-scene-target={it.target} aria-label={it.aria}
                style={`clip-path:${it.g.poly}`}></button>
              <div class="obj-lift" aria-hidden="true">
                <div class="obj-art" style={`clip-path:${it.g.poly};background-size:${it.g.bgSize};background-position:${it.g.bgPos}`}></div>
              </div>
              {it.tip && (
                <span class="obj-tip" aria-hidden="true"><b>{it.tip}</b>{it.sub && <i>{it.sub}</i>}</span>
              )}
            </div>
          ))}

          <!-- СВИТКИ (разметка и содержимое прежние; hover — только по самому свитку) -->
      <!-- 4. СВИТОК «САЙТЫ / ЛЕНДИНГИ» (ГОРИЗОНТАЛЬНЫЙ ФИЗИЧЕСКИЙ СВИТОК) -->
      <div 
        class="hotspot hotspot-scroll-sites physical-scroll-horizontal" 
        data-target="modal-sites" 
        role="button"
        tabindex="0"
        aria-label="Сайты / Лендинги: Каталог действующих веб-проектов"
        title="Сайты / Лендинги"
      >
        <!-- 1. Закрытый рулон (в исходном состоянии лежит на листе стола) -->
        <div class="sites-closed-wrapper">
          <img src="/svitok-closed.png" alt="Свиток Сайты / Лендинги (закрытый)" class="sites-closed-img" />
          <div class="sites-closed-tag">
            <span>{site.scrolls.sites.closedTag}</span>
          </div>
          <div class="sites-pulse-seal"></div>
        </div>

        <!-- 2. Развёрнутый свиток (плавно разворачивается по горизонтали в обе стороны влево и вправо) -->
        <div class="sites-unrolled-wrapper">
          <div class="scroll-roll-left">
            <div class="scroll-roll-finial finial-top"></div>
            <div class="scroll-roll-cylinder"></div>
            <div class="scroll-roll-finial finial-bottom"></div>
          </div>
          <div class="scroll-parchment-sheet">
            <div class="sites-parchment-content">
              <div class="sites-parchment-header">
                <span class="sites-parchment-tag">{site.scrolls.sites.tag}</span>
                <span class="sites-parchment-badge">{site.scrolls.sites.badge}</span>
              </div>

              <!-- Мини-меню проектов: клик сразу открывает персональное досье -->
              <div class="sites-screens-strip">
                {P.landings.filter((l: any) => l.status === 'published').map((landing: any) => (
                  <button 
                    type="button" 
                    class="sites-screen-chip" 
                    data-open-drawer={landing.drawerId || ("modal-landing-" + landing.id)} 
                    title={`${landing.name} — открыть досье`}
                    aria-label={`${landing.name}: открыть персональное досье проекта`}
                  >
                    <img src={landing.screenPreview} alt={`${landing.name} — первый экран`} />
                    <span class="chip-label">{landing.chipLabel || landing.name}</span>
                  </button>
                ))}
              </div>

              <div class="sites-parchment-sub">{W0}{site.scrolls.sites.sub}{W1}<span class="sites-arrow">➔</span>
              </div>
            </div>
            <div class="sites-wax-seal"></div>
          </div>
          <div class="scroll-roll-right">
            <div class="scroll-roll-finial finial-top"></div>
            <div class="scroll-roll-cylinder"></div>
            <div class="scroll-roll-finial finial-bottom"></div>
          </div>
        </div>
      </div>


      <!-- 6. СВИТОК «БОТЫ // TELEGRAM» (ФИЗИЧЕСКИЙ СВИТОК СО СМАРТФОНОМ ВНУТРИ) -->
      <div 
        class="hotspot hotspot-scroll-bots physical-scroll-bots" 
        data-target="modal-bots" 
        role="button"
        tabindex="0"
        aria-label="Боты: Telegram-боты лаборатории"
        title="Боты // Telegram: открыть каталог ботов"
      >
        <!-- 1. Закрытый свиток (в исходном состоянии лежит на столе, телефон полностью скрыт внутри) -->
        <div class="bots-closed-wrapper">
          <img src="/svitok-closed.png" alt="Свиток Боты (закрытый)" class="bots-closed-img" />
          <div class="bots-closed-tag">
            <span>{site.scrolls.bots.closedTag}</span>
          </div>
          <div class="bots-pulse-seal"></div>
        </div>

        <!-- 2. Развёрнутый свиток (физически разворачивается, на нём лежит настоящий смартфон с работающими ботами) -->
        <div class="bots-unrolled-wrapper">
          <span class="bots-spine" aria-hidden="true"></span>
          <img 
            src="/svitok-bots-open.png" 
            alt="Раскрытый свиток с физическим смартфоном и Telegram-ботами" 
            class="bots-unrolled-img" 
          />
          
          <!-- Интерактивные кликабельные зоны поверх карточек ботов на экране смартфона -->
          {botDrawers.has('modal-myasnaya-troitsa') && (
          <button 
            type="button" 
            class="phone-interactive-hotspot hotspot-meat" 
            data-open-drawer="modal-myasnaya-troitsa"
            title="Мясная Троица — открыть досье"
            aria-label="Мясная Троица: открыть персональное досье проекта"
          ></button>
          )}

          {botDrawers.has('modal-aichatbot') && (
          <button 
            type="button" 
            class="phone-interactive-hotspot hotspot-detective" 
            data-open-drawer="modal-aichatbot"
            title="Бот Детектив — открыть досье"
            aria-label="Бот Детектив: открыть персональное досье проекта"
          ></button>
          )}
        </div>
      </div>



      <!-- 11. СВИТОК «АВТОР» (Физический интерактивный свиток на столе) -->
      <button 
        type="button" 
        class="hotspot hotspot-scroll physical-scroll-object" 
        data-target="modal-about" 
        aria-label="Автор: «Хорошие идеи приходят не по расписанию.»"
      >
        <!-- 1. Закрытый рулон (в исходном состоянии лежит на столе) -->
        <div class="scroll-closed-wrapper">
          <img src="/svitok-closed.png" alt="Свиток Автор (закрытый)" class="scroll-closed-img" />
          <div class="scroll-closed-tag">
            <span>{site.scrolls.author.closedTag}</span>
          </div>
          <div class="scroll-pulse-seal"></div>
        </div>

        <!-- 2. Развёрнутый свиток (физически разворачивается в свободную зону при наведении) -->
        <div class="scroll-unrolled-wrapper">
          <img src="/svitok-open.png" alt="Развёрнутый свиток: Хорошие идеи приходят не по расписанию" class="scroll-open-img" />
        </div>
      </button>


        </div>
      </div>

      <!-- Надпись и связь поверх сцены -->
      <div class="scene-hud">
        <a href="/" class="scene-brand" aria-label="GONKA.BLOG: цифровая лаборатория — на главную">
          <strong>GONKA<span>.BLOG</span></strong>
          <em>цифровая лаборатория</em>
          <small>проекты • эксперименты • идеи</small>
        </a>
        <div class="scene-social">
          {socials.filter((x: any) => x.enabled).map((x: any) => (
            <a href={x.url} target={x.newTab ? "_blank" : undefined} rel={x.newTab ? "noopener noreferrer" : undefined} title={x.title} aria-label={x.ariaLabel}>
              {x.icon === "telegram" && (<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.9 4.3 2.7 11.6c-.9.3-.9 1.1-.2 1.4l4.9 1.5 1.9 5.8c.2.6.4.8.9.8s.7-.2 1-.5l2.5-2.4 4.9 3.6c.9.5 1.5.2 1.8-.8l3.2-15.2c.3-1.3-.5-1.9-1.4-1.5ZM9 14.3l9.4-5.9c.4-.3.8-.1.5.2L11 15.6l-.3 3.3-1.7-4.6Z"/></svg>)}
              {x.icon === "email" && (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="4.5" width="19" height="15" rx="2.5"/><path d="m3.5 7 8.5 6.5L20.5 7"/></svg>)}
              {x.icon === "youtube" && (<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
        </svg>)}
              {x.icon === "instagram" && (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
          <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
        </svg>)}
              {x.icon === "link" && (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3A4 4 0 0 0 11 18.7l1-1"/></svg>)}
              <span class="sr-only">{x.label}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- 13. ПРАВАЯ ВЕРТИКАЛЬНАЯ НАВИГАЦИЯ (ОГЛАВЛЕНИЕ СТОЛА ИЗ 8 ОСНОВНЫХ РАЗДЕЛОВ) -->
      <nav class="cabinet-menu-nav" aria-label="Оглавление интерактивного стола">
        <div class="cabinet-nav-backdrop" aria-hidden="true"></div>

        <!-- 1. ЧЕРНОВИК -->
        <button type="button" class="hotspot cabinet-nav-item" data-target="modal-draft" aria-label="Черновик: открыть лабораторные записи и эскизы">
          <span class="cabinet-nav-label">{site.nav[0].label}</span>
        </button>

        <!-- 2. ЛЕНДИНГИ -->
        <button type="button" class="hotspot cabinet-nav-item" data-target="modal-sites" aria-label="Лендинги: открыть каталог действующих веб-проектов">
          <span class="cabinet-nav-label">{site.nav[1].label}</span>
        </button>

        <!-- 3. СИСТЕМА -->
        <button type="button" class="hotspot cabinet-nav-item" data-target="modal-core" aria-label="Система: открыть архитектуру и ядро GONKA.BLOG">
          <span class="cabinet-nav-label">{site.nav[2].label}</span>
        </button>

        <!-- 4. ТРЕКЕРЫ -->
        <button type="button" class="hotspot cabinet-nav-item" data-target="modal-trackers" aria-label="Трекеры: открыть каталог таск-трекеров">
          <span class="cabinet-nav-label">{site.nav[3].label}</span>
        </button>

        <!-- 5. НЕ ПОШЛО -->
        <button type="button" class="hotspot cabinet-nav-item" data-target="modal-failures" aria-label="Не пошло: открыть архив закрытых гипотез">
          <span class="cabinet-nav-label">{site.nav[4].label}</span>
        </button>

        <!-- 6. ВИДЕО -->
        <button type="button" class="hotspot cabinet-nav-item" data-target="modal-video" aria-label="Видео: открыть монтаж и кадры рабочего процесса">
          <span class="cabinet-nav-label">{site.nav[5].label}</span>
        </button>

        <!-- 7. ИНСТРУМЕНТЫ -->
        <button type="button" class="hotspot cabinet-nav-item" data-target="modal-network" aria-label="Инструменты: открыть стек технологий и связи">
          <span class="cabinet-nav-label">{site.nav[6].label}</span>
        </button>

        <!-- 8. БОТЫ -->
        <button type="button" class="hotspot cabinet-nav-item" data-target="modal-bots" aria-label="Боты: открыть каталог Telegram-ботов лаборатории">
          <span class="cabinet-nav-label">{site.nav[7].label}</span>
        </button>
      </nav>

    </div>
  </main>

  <!-- ВЫДВИЖНЫЕ ПРАВЫЕ ПАНЕЛИ (КРАТКИЕ ФАКТЫ, БЕЗ ВОДЫ И МАРКЕТИНГА) -->

  <!-- 1. СИСТЕМА // GONKA.BLOG CORE -->
  <aside id="modal-core" class="workbench-drawer">
    <div class="drawer-content">
      
      <div class="drawer-header">
        <div class="drawer-header-left">
          <span class="drawer-tag text-orange">{S['modal-core'].header.tag}</span>
          <span class="case-badge">{S['modal-core'].header.badge}</span>
        </div>
        <div class="drawer-header-actions">

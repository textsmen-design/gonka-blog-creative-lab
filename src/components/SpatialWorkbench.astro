  .scene-stage .hotspot-scroll-sites.physical-scroll-horizontal:focus-visible,
  .scene-stage .hotspot-scroll-bots.physical-scroll-bots:focus-visible,
  .scene-stage .hotspot-scroll.physical-scroll-object:focus-visible { outline: none; }

  /* ---- надпись и связь ---- */
  .scene-hud {
    position: absolute; z-index: 60; top: 10px; left: 16px; right: calc(var(--menu-w) + 16px);

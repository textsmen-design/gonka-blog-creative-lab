  .obj-tip i { font: italic 500 11px/1.25 'Space Grotesk', system-ui, sans-serif; color: #5a3519; max-width: 220px; white-space: normal; }
  /* ---- свитки: hover/клик только по самому свитку, а не по прямоугольнику вокруг ---- */
  .scene-stage .hotspot-scroll-sites.physical-scroll-horizontal,

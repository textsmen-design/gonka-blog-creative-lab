    gap: 16px;
  }
  .catalog-project-card {
    background: rgba(26, 21, 17, 0.85);
    background-image: linear-gradient(135deg, rgba(38, 30, 24, 0.85) 0%, rgba(22, 17, 14, 0.95) 100%);
    border: 1px solid rgba(245, 158, 11, 0.2);
    border-left: 3.5px solid #ea580c;
    border-radius: 8px;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;

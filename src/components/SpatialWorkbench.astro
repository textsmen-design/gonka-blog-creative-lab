  /* РЕАЛЬНЫЕ ПЕРВЫЕ ЭКРАНЫ В КАРТОЧКАХ КАТАЛОГА */
  .catalog-card-screen {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 6px;
    overflow: hidden;
    background: #0f0d0b;

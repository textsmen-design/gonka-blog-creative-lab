  .scene-brand strong span { color: #f97316; }
  .scene-brand em { font-style: normal; font-size: clamp(11px, 1.1vw, 15px); color: #f6e3bf; }
  .scene-brand small { font-size: 10px; letter-spacing: 0.12em; color: #ead6b0; opacity: 0.9; }
  .scene-social { pointer-events: auto; display: flex; gap: 8px; }
  .scene-social a {
    width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center;
    background: rgba(18, 12, 8, 0.55); border: 1px solid rgba(255, 214, 150, 0.35); color: #f7e7c8;
    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, color 0.2s ease;
  }
  .scene-social a svg { width: 18px; height: 18px; }
  .scene-social a:hover, .scene-social a:focus-visible {
    transform: translateY(-2px); color: #fff; border-color: #ffb84d; outline: none;
    box-shadow: 0 0 14px rgba(255, 184, 77, 0.45), 0 6px 12px rgba(0, 0, 0, 0.5);
  }
  .scene-social a:active { transform: translateY(0); }

  /* ---- переключатель день/ночь ---- */
  .theme-pill {
    position: relative; width: 62px; height: 28px; padding: 0; border-radius: 999px;
    display: block; overflow: hidden;
    background: linear-gradient(90deg, #3a2a14 0%, #1a2340 100%);

    border-left: 1px solid rgba(34, 197, 94, 0.3);
  }

  /* 2. САЙТЫ / ЛЕНДИНГИ (интерфейс / браузер / рабочая среда) */
  #modal-sites,
  #modal-english-teacher,
  #modal-twohearts,
  #modal-siteviza,
  #modal-atelier,
  #modal-landasset5,
  #modal-tracker01 {

</style>

<script>
  function initSpatialWorkbench() {
    // 1. Часы
    const clockEl = document.getElementById('live-clock');
    function updateClock() {
      if (clockEl) {
        const now = new Date();
        const h = String(now.getHours()).padStart(2, '0');
        const m = String(now.getMinutes()).padStart(2, '0');
        const s = String(now.getSeconds()).padStart(2, '0');
        clockEl.textContent = `${h}:${m}:${s} CET`;
      }
    }
    setInterval(updateClock, 1000);
    updateClock();

    // 2. Открытие, разворачивание и закрытие досье
    const hotspots = document.querySelectorAll('.hotspot');
    const drawers = document.querySelectorAll('.workbench-drawer');
    const backdrop = document.getElementById('drawer-backdrop');
    const closeButtons = document.querySelectorAll('.close-drawer-btn');
    const expandButtons = document.querySelectorAll('.expand-drawer-btn');

    function openDrawer(targetId: string) {
      closeAllDrawers();
      const target = document.getElementById(targetId);
      if (target && backdrop) {
        target.classList.remove('is-expanded');
        target.classList.add('is-open');
        backdrop.classList.add('is-active');
      }
      document.querySelectorAll('.cabinet-nav-item').forEach((item) => {
        if (item.getAttribute('data-target') === targetId) {
          item.classList.add('is-active');
        } else {
          item.classList.remove('is-active');
        }
      });
    }

    function toggleExpand(drawer: HTMLElement) {
      const isExpanded = drawer.classList.contains('is-expanded');
      const label = drawer.querySelector('.expand-label');
      if (isExpanded) {
        drawer.classList.remove('is-expanded');
        if (label) label.textContent = 'НА ВЕСЬ СТОЛ';
      } else {
        drawer.classList.add('is-expanded');
        if (label) label.textContent = 'СВЕРНУТЬ В ПАНЕЛЬ';
      }
    }

    function closeAllDrawers() {
      drawers.forEach((d) => {
        d.classList.remove('is-open');
        d.classList.remove('is-expanded');
        const label = d.querySelector('.expand-label');
        if (label) label.textContent = 'НА ВЕСЬ СТОЛ';
      });
      if (backdrop) backdrop.classList.remove('is-active');
      document.querySelectorAll('.cabinet-nav-item').forEach((item) => {
        item.classList.remove('is-active');
      });
    }

    hotspots.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const targetId = btn.getAttribute('data-target');
        if (targetId) {
          openDrawer(targetId);
        }
      });
      if (btn.tagName !== 'BUTTON') {
        btn.addEventListener('keydown', (e) => {
          const keyEv = e as KeyboardEvent;
          if (keyEv.key === 'Enter' || keyEv.key === ' ') {
            if (e.target === btn) {
              e.preventDefault();
              e.stopPropagation();
              const targetId = btn.getAttribute('data-target');
              if (targetId) openDrawer(targetId);
            }
          }
        });
      }
    });

    document.querySelectorAll('[data-open-drawer]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const targetId = btn.getAttribute('data-open-drawer');
        if (targetId) {
          openDrawer(targetId);
        }
      });
    });

    closeButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        closeAllDrawers();
      });
    });

    document.querySelectorAll('a.topbar-brand, a.workbench-table-logo-link').forEach((brandLink) => {
      brandLink.addEventListener('click', (e) => {
        const anyOpen = document.querySelector('.workbench-drawer.is-open');
        if (anyOpen) {
          e.preventDefault();
          closeAllDrawers();
          if (window.location.search) {
            history.pushState(null, '', '/');
          }
        }
      });
    });

    expandButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const drawer = btn.closest('.workbench-drawer') as HTMLElement;
        if (drawer) {
          toggleExpand(drawer);
        }
      });
    });

    backdrop?.addEventListener('click', closeAllDrawers);

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeAllDrawers();
      }
    });

    // 3. Тумблер темы (День / Ночь)
    const toggleBtn = document.getElementById('desk-theme-toggle');
    const themeIcon = document.getElementById('desk-theme-icon');
    const themeLabel = document.getElementById('desk-theme-label');
    const html = document.documentElement;

    function applyDeskTheme(theme: string) {
      html.setAttribute('data-theme', theme);
      if (themeIcon && themeLabel) {
        if (theme === 'night') {
          themeIcon.textContent = '☽';
          themeLabel.textContent = 'НОЧЬ';
        } else {
          themeIcon.textContent = '☼';
          themeLabel.textContent = 'ДЕНЬ';
        }
      }
    }

    const currentHour = new Date().getHours();
    const defaultTheme = (currentHour >= 20 || currentHour < 7) ? 'night' : 'day';
    const saved = localStorage.getItem('gonka-theme') || defaultTheme;
    applyDeskTheme(saved);

    toggleBtn?.addEventListener('click', () => {
      const current = html.getAttribute('data-theme');
      const next = current === 'night' ? 'day' : 'night';
      localStorage.setItem('gonka-theme', next);
      applyDeskTheme(next);
    });

    // 4. Проверка URL-параметров
    const urlParams = new URLSearchParams(window.location.search);
    const themeParam = urlParams.get('theme');
    if (themeParam) {
      applyDeskTheme(themeParam);
    }
    const openParam = urlParams.get('open');
    if (openParam) {
      openDrawer(openParam);
      if (urlParams.get('expanded') === 'true') {
        const target = document.getElementById(openParam);
        if (target) toggleExpand(target);
      }
    }
    const hoverParam = urlParams.get('hover');
    if (hoverParam) {
      document.querySelector(`.hotspot[data-target="${hoverParam}"]`)?.classList.add('is-hovered');
    }
  }

  initSpatialWorkbench();
</script>

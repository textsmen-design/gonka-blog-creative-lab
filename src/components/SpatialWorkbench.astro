    background-image: 
      radial-gradient(circle at 90% 10%, rgba(34, 197, 94, 0.09) 0%, transparent 55%),
      radial-gradient(circle at 10% 90%, rgba(16, 185, 129, 0.04) 0%, transparent 50%),
      linear-gradient(rgba(52, 211, 153, 0.015) 1px, transparent 1px),
      linear-gradient(180deg, #15201b 0%, #0d1411 100%);

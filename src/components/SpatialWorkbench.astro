  /* Крафтовая бирка «САЙТЫ / ЛЕНДИНГИ», закрепленная на свернутом свитке */
  .sites-closed-tag {
    position: absolute;
    bottom: -6px;
    left: 50%;
    transform: translateX(-50%) rotate(-3deg);
    padding: 2.5px 8px;
    background: #eadebe;
    background-image: linear-gradient(135deg, #f5ebd2 0%, #d8be92 100%);
    border: 1px solid rgba(120, 75, 30, 0.5);
    border-radius: 3px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.5);
    pointer-events: none;
    white-space: nowrap;
    z-index: 2;

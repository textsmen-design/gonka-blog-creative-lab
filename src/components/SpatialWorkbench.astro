  .phone-pulse-ring {
    position: absolute;
    top: 22%;
    left: 48%;
    width: 32px;
    height: 32px;
    border-radius: 9999px;
    border: 2px solid rgba(249, 115, 22, 0.6);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .hotspot-phone:hover .phone-pulse-ring,
  .hotspot-phone.is-hovered .phone-pulse-ring {
    opacity: 1;
    animation: ping 1.4s cubic-bezier(0, 0, 0.2, 1) infinite;

  /* 1. Закрытый рулон на листе стола (исходное состояние) */
  .sites-closed-wrapper {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 66%;
    max-width: 135px;
    height: auto;
    pointer-events: auto;
    transition: opacity 0.28s ease, transform 0.32s cubic-bezier(0.16, 1, 0.3, 1);

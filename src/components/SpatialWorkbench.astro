    background: linear-gradient(90deg, #3d2212 0%, #7c4720 18%, #c99859 40%, #faecd5 58%, #8e5425 80%, #351c0d 100%);
    box-shadow: inset 0 2px 3px rgba(255, 255, 255, 0.4), inset 0 -2px 3px rgba(0, 0, 0, 0.5);

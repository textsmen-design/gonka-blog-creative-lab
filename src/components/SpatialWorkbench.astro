  }

  /* РЕАЛЬНЫЕ ПЕРВЫЕ ЭКРАНЫ В КАРТОЧКАХ КАТАЛОГА */
  .catalog-card-screen {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 6px;
    overflow: hidden;
    background: #0f0d0b;
    border: 1px solid rgba(245, 158, 11, 0.25);
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.55);
  }

  .catalog-screen-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), filter 0.35s ease;
  }

  .catalog-project-card:hover .catalog-screen-img {
    transform: scale(1.035);
  }

  .catalog-screen-overlay {
    position: absolute;
    bottom: 6px;
    left: 8px;
    display: flex;
    align-items: center;
    gap: 6px;
    z-index: 2;
  }

  .screen-url-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px;
    font-weight: 700;
    color: #fef08a;
    background: rgba(15, 12, 10, 0.88);
    backdrop-filter: blur(4px);
    border: 1px solid rgba(245, 158, 11, 0.45);
    padding: 2px 7px;
    border-radius: 3px;
    letter-spacing: 0.04em;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.45);

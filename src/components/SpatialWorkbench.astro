    align-items: center;
    gap: 6px;
    z-index: 2;
  }

  .screen-url-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px;
    font-weight: 700;
    color: #fef08a;
    background: rgba(15, 12, 10, 0.88);
    backdrop-filter: blur(4px);
    border: 1px solid rgba(245, 158, 11, 0.45);
    padding: 2px 7px;
    border-radius: 3px;
    letter-spacing: 0.04em;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.45);

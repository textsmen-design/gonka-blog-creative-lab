  /* СЛОТ 1: ЛАМПА */
  .hotspot-slot-lamp {
    top: 0.0%;
    left: 33.0%;
    width: 9.0%;
    height: 17.0%;
    border-radius: 50% 50% 20% 20%;
    border: 1px dashed transparent;
    transition: all 0.3s ease;
  }
  .hotspot-slot-lamp:hover,
  .hotspot-slot-lamp.is-hovered {
    border-color: rgba(245, 158, 11, 0.7);
    background: rgba(245, 158, 11, 0.03);
    transform: translateY(-2px);
    box-shadow: 0 0 20px rgba(245, 158, 11, 0.25);
  }

  /* СЛОТ 2: КРУЖКА */
  .hotspot-slot-mug,
  .hotspot-mug {
    top: 11.0%;
    left: 68.0%;
    width: 10.5%;
    height: 18.0%;
    border-radius: 50%;
    border: 1px dashed transparent;
    transition: all 0.3s ease;
  }
  .hotspot-slot-mug:hover,
  .hotspot-slot-mug.is-hovered,
  .hotspot-mug:hover,
  .hotspot-mug.is-hovered {
    border-color: rgba(245, 158, 11, 0.7);
    background: rgba(245, 158, 11, 0.03);
    transform: translateY(-2px);
    box-shadow: 0 0 20px rgba(245, 158, 11, 0.25);
  }

  /* СЛОТ 3: КОМПАС */
  .hotspot-slot-compass {
    top: 20.0%;
    left: 46.0%;
    width: 5.5%;
    height: 9.0%;
    border-radius: 50%;
    border: 1px dashed transparent;
    transition: all 0.3s ease;
  }
  .hotspot-slot-compass:hover,
  .hotspot-slot-compass.is-hovered {
    border-color: rgba(245, 158, 11, 0.7);
    background: rgba(245, 158, 11, 0.03);
    transform: translateY(-2px);
    box-shadow: 0 0 20px rgba(245, 158, 11, 0.25);
  }

  /* СЛОТ 4: ДВЕ ФОТОГРАФИИ */
  .hotspot-slot-photos {
    top: 18.9%;
    left: 54.0%;
    width: 14.0%;
    height: 13.0%;
    border-radius: 8px;
    border: 1px dashed transparent;
    transition: all 0.3s ease;
  }
  .hotspot-slot-photos:hover,
  .hotspot-slot-photos.is-hovered {
    border-color: rgba(245, 158, 11, 0.7);
    background: rgba(245, 158, 11, 0.03);
    transform: translateY(-2px);
    box-shadow: 0 0 20px rgba(245, 158, 11, 0.25);
  }

  /* ПЛАШКА «ТРЕКЕРЫ» (БЫВШИЙ РЕЛОКАНТ СЕРБИЯ) */
  .hotspot-trackers,
  .hotspot-serbia-wip {
    top: 64.0%;
    left: 65.5%;
    width: 19.0%;
    height: 32.5%;
    border-radius: 8px;
    border: 1px dashed transparent;
    background: transparent;
    overflow: visible;
    transition: all 0.3s ease;
  }
  .hotspot-trackers:hover,
  .hotspot-trackers.is-hovered,
  .hotspot-serbia-wip:hover,
  .hotspot-serbia-wip.is-hovered {
    border-color: rgba(245, 158, 11, 0.9);
    background: rgba(245, 158, 11, 0.04);
    transform: translateY(-2px);
    box-shadow: 0 0 20px rgba(245, 158, 11, 0.3);
  }
  .hotspot-trackers:hover .hotspot-aura,
  .hotspot-trackers.is-hovered .hotspot-aura,
  .hotspot-serbia-wip:hover .hotspot-aura,
  .hotspot-serbia-wip.is-hovered .hotspot-aura {
    opacity: 1;
    box-shadow: 0 0 28px rgba(245, 158, 11, 0.35), inset 0 0 14px rgba(245, 158, 11, 0.15);
  }

  /* СЛОТ 6: СТАКАН С КАРАНДАШАМИ И РУЧКАМИ */
  .hotspot-slot-pencilcup {
    top: 16.5%;
    left: 37.4%;
    width: 6.8%;
    height: 19.5%;
    border-radius: 8px;
    border: 1px dashed transparent;
    background: transparent;
    overflow: visible;
    transition: all 0.3s ease;
  }
  .hotspot-slot-pencilcup:hover,
  .hotspot-slot-pencilcup.is-hovered {
    border-color: rgba(245, 158, 11, 0.9);
    background: rgba(245, 158, 11, 0.04);
    transform: translateY(-2px);
    box-shadow: 0 0 20px rgba(245, 158, 11, 0.3);
  }
  .hotspot-slot-pencilcup:hover .hotspot-aura,
  .hotspot-slot-pencilcup.is-hovered .hotspot-aura {
    opacity: 1;
    box-shadow: 0 0 28px rgba(245, 158, 11, 0.35), inset 0 0 14px rgba(245, 158, 11, 0.15);
  }

  /* АКТИВНЫЙ ПРОЕКТ: ПЛАШКА SRBIJA */
  .hotspot-srbija {
    top: 10.9%;
    left: 77.9%;
    width: 7.2%;
    height: 13.5%;
    border-radius: 6px;
    border: 1px dashed transparent;
    background: transparent;
    overflow: visible;
    transition: all 0.3s ease;
  }
  .hotspot-srbija:hover,
  .hotspot-srbija.is-hovered {
    border-color: rgba(245, 158, 11, 0.9);
    background: rgba(245, 158, 11, 0.04);
    transform: translateY(-2px);
    box-shadow: 0 0 20px rgba(245, 158, 11, 0.3);
  }
  .hotspot-srbija:hover .hotspot-aura,
  .hotspot-srbija.is-hovered .hotspot-aura {
    opacity: 1;
    box-shadow: 0 0 28px rgba(245, 158, 11, 0.35), inset 0 0 14px rgba(245, 158, 11, 0.15);
  }

  /* 11. СВИТОК «ОБО МНЕ» (ФИЗИЧЕСКИЙ АРТЕФАКТ НА СТОЛЕ) */
  .hotspot-scroll.physical-scroll-object {
    position: absolute;
    top: 6.0%;
    left: 23.0%;
    width: 13.8%;
    height: 21.8%;
    border: none;
    background: transparent;
    padding: 0;
    margin: 0;
    cursor: pointer;
    z-index: 35;
    outline: none;
    box-shadow: none;
    transform: none;
    -webkit-tap-highlight-color: transparent;
  }

  .hotspot-scroll.physical-scroll-object:hover,
  .hotspot-scroll.physical-scroll-object.is-hovered {
    border: none;
    box-shadow: none;
    transform: none;
  }

  .hotspot-scroll.physical-scroll-object:focus-visible {
    outline: 2px dashed rgba(245, 158, 11, 0.7);
    outline-offset: 4px;
    border-radius: 8px;
  }

  /* 1. Закрытый рулон на столе (исходное состояние) */
  .scroll-closed-wrapper {
    position: absolute;
    top: 14%;
    left: 5%;
    width: 90%;
    height: auto;
    pointer-events: auto;
    transition: opacity 0.32s cubic-bezier(0.16, 1, 0.3, 1), transform 0.32s cubic-bezier(0.16, 1, 0.3, 1);
    transform-origin: center center;
    filter: drop-shadow(0 8px 18px rgba(0, 0, 0, 0.75));
  }

  .scroll-closed-img {
    display: block;
    width: 100%;
    height: auto;
    user-select: none;
    pointer-events: none;
  }

  /* Крафтовая бирка «АВТОР», закрепленная на свернутом свитке */
  .scroll-closed-tag {
    position: absolute;
    bottom: -6px;
    left: 50%;
    transform: translateX(-50%) rotate(-4deg);
    padding: 2.5px 8px;
    background: #eadebe;
    background-image: linear-gradient(135deg, #f5ebd2 0%, #d8be92 100%);
    border: 1px solid rgba(120, 75, 30, 0.5);
    border-radius: 3px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.5);
    pointer-events: none;
    white-space: nowrap;
    z-index: 2;
  }

  .scroll-closed-tag span {
    font-family: 'Space Grotesk', -apple-system, sans-serif;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.16em;
    color: #431407;
    text-transform: uppercase;
    display: block;
  }

  /* Деликатный пульсирующий отблеск на сургучной печати */
  .scroll-pulse-seal {
    position: absolute;
    top: 36%;
    left: 58%;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(239, 68, 68, 0.5) 0%, rgba(220, 38, 38, 0.15) 50%, rgba(0, 0, 0, 0) 70%);
    pointer-events: none;
    animation: scroll-seal-shimmer 3.2s infinite ease-in-out;
  }

  @keyframes scroll-seal-shimmer {
    0%, 100% {
      transform: translate(-50%, -50%) scale(0.9);
      opacity: 0.35;
    }
    50% {
      transform: translate(-50%, -50%) scale(1.35);
      opacity: 0.85;
    }
  }

  /* 2. Развёрнутый свиток (разворачивается вниз строго в свободной области, не закрывая лендинги) */
  .scroll-unrolled-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    transform: scaleY(0.18) translateY(-10px);
    transform-origin: top center;
    clip-path: inset(0 0 82% 0);
    filter: drop-shadow(0 16px 30px rgba(0, 0, 0, 0.85));
    transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.42s cubic-bezier(0.16, 1, 0.3, 1),
                clip-path 0.42s cubic-bezier(0.16, 1, 0.3, 1),
                filter 0.42s ease;
  }

  .scroll-open-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: top center;
    user-select: none;
    pointer-events: none;
  }

  /* Штамп «ОБО МНЕ» на развёрнутом пергаменте */
  .scroll-unrolled-stamp {
    position: absolute;
    top: 18%;
    left: 50%;
    transform: translateX(-50%) rotate(-2.5deg);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .scroll-stamp-tag {
    font-family: 'Space Grotesk', -apple-system, sans-serif;
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.22em;
    color: #431407;
    background: rgba(245, 230, 203, 0.88);
    border: 1px dashed rgba(120, 53, 15, 0.5);
    padding: 2px 8px;
    border-radius: 3px;
    text-transform: uppercase;
    box-shadow: 0 1px 4px rgba(67, 20, 7, 0.2);
    backdrop-filter: blur(2px);
  }

  /* Реакция на hover и is-hovered */
  .hotspot-scroll.physical-scroll-object:hover .scroll-closed-wrapper,
  .hotspot-scroll.physical-scroll-object.is-hovered .scroll-closed-wrapper {
    opacity: 0;
    transform: scale(0.94) translateY(-4px);
    pointer-events: none;
  }

  .hotspot-scroll.physical-scroll-object:hover .scroll-unrolled-wrapper,
  .hotspot-scroll.physical-scroll-object.is-hovered .scroll-unrolled-wrapper {
    opacity: 1;
    pointer-events: auto;
    transform: scaleY(1) translateY(0);
    clip-path: inset(0 0 0 0);
    filter: drop-shadow(0 22px 38px rgba(0, 0, 0, 0.9));
  }

  /* 12. КРУЖКА */
  .hotspot-mug {
    top: 11.0%;
    left: 68.0%;
    width: 10.5%;
    height: 18.0%;
    border-radius: 50%;
  }

  /* 13. ПРАВАЯ ВЕРТИКАЛЬНАЯ НАВИГАЦИЯ (ОГЛАВЛЕНИЕ СТОЛА — 8 РАЗДЕЛОВ) */
  .cabinet-menu-nav {
    position: absolute;
    top: 27.5%;
    left: 86.6%;
    width: 12.0%;
    height: 46.5%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 5px;
    z-index: 28;
    pointer-events: auto;
  }

  /* Фоновые темные деревянные рейки под меню — надежно закрывают старые фоновые надписи */
  .cabinet-nav-backdrop {
    position: absolute;
    inset: -4px 0;
    background: #17110c;
    background-image: 
      repeating-linear-gradient(180deg, 
        #17110c 0px, 
        #211812 3px, 
        #2a1e16 24px, 
        #1b130e 45px, 
        #0e0a07 48px, 
        #050403 50px
      );
    border-radius: 3px;
    box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.7);
    z-index: -1;
    pointer-events: none;
  }

  /* ЕДИНЫЙ СТИЛЬ ДЛЯ ВСЕХ 8 ПУНКТОВ МЕНЮ */
  .cabinet-nav-item {
    position: relative;
    width: 100%;
    flex: 1;
    min-height: 32px;
    max-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(180deg, #ede3d2 0%, #dfd3bd 100%);
    border: 1px solid rgba(130, 85, 45, 0.45);
    border-radius: 4px;
    box-shadow: 
      0 2px 5px rgba(0, 0, 0, 0.6),
      inset 0 1px 0 rgba(255, 255, 255, 0.65),
      inset 0 -1px 0 rgba(0, 0, 0, 0.1);
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    outline: none;
    padding: 0 6px;
  }

  /* Латунные заклепки по углам планок */
  .cabinet-nav-item::before,
  .cabinet-nav-item::after {
    content: '';
    position: absolute;
    width: 3px;
    height: 3px;
    background: #55331c;
    border-radius: 50%;
    box-shadow: 0 0.5px 1px rgba(255, 255, 255, 0.5);
    opacity: 0.6;
  }
  .cabinet-nav-item::before { top: 4px; left: 6px; }
  .cabinet-nav-item::after { top: 4px; right: 6px; }

  /* Одинаковая типографика для всех 8 пунктов */
  .cabinet-nav-label {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #2b180d;
    text-transform: uppercase;
    text-shadow: 0 0.5px 0 rgba(255, 255, 255, 0.45);
    white-space: nowrap;
    pointer-events: none;
  }

  /* Одинаковый Hover для всех 8 пунктов */
  .cabinet-nav-item:hover,
  .cabinet-nav-item:focus-visible,
  .cabinet-nav-item.is-hovered {
    background: linear-gradient(180deg, #f5ebd9 0%, #ede0c9 100%);
    border-color: rgba(245, 158, 11, 0.8);
    box-shadow: 
      0 0 16px rgba(245, 158, 11, 0.4),
      0 3px 8px rgba(0, 0, 0, 0.7),
      inset 0 1px 0 rgba(255, 255, 255, 0.85);
    transform: translateX(-2.5px);
  }

  /* Одинаковое активное состояние для всех 8 пунктов */
  .cabinet-nav-item.is-active,
  .cabinet-nav-item:active {
    background: linear-gradient(180deg, #dfd3bd 0%, #cfc1a7 100%);
    border-color: #ea580c;
    box-shadow: 
      0 0 12px rgba(234, 88, 12, 0.4),
      inset 0 2px 4px rgba(0, 0, 0, 0.25);
    transform: translateX(-1px);
  }

  /* ==================================================
     СИСТЕМА HOVER-ПОДСКАЗОК (ФИЗИЧЕСКИЕ АРТЕФАКТЫ НА СТОЛЕ)
     ================================================== */
  .editorial-float-label {
    position: absolute;
    display: flex;
    flex-direction: column;
    gap: 3px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1), transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 50;
    white-space: nowrap;
  }

  .editorial-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #f97316;
  }
  .tag-red { color: #f87171; }
  .tag-emerald { color: #34d399; }
  .tag-purple { color: #c084fc; }
  .tag-blue { color: #60a5fa; }

  .editorial-statement {
    font-family: 'Literata', Georgia, serif;
    font-style: italic;
    font-size: 11.5px;
    color: #f5f5f4;
    line-height: 1.25;
  }
  .statement-red { color: #fca5a5; }

  /* 1. ЧЕРНОВИК: Кусок старого тёплого пергамента с неровным краем и отчётливой рукописной фразой */
  .label-draft-parchment {
    padding: 11px 18px;
    background: #eadebe;
    background-image: 
      radial-gradient(circle at 20% 30%, rgba(255, 255, 255, 0.35) 0%, transparent 60%),
      radial-gradient(circle at 80% 70%, rgba(138, 90, 43, 0.15) 0%, transparent 70%),
      linear-gradient(135deg, #f5ebd2 0%, #e1d0ab 100%);
    border: 1px solid #b89d70;
    border-radius: 3px 14px 4px 18px / 16px 4px 14px 3px;
    box-shadow: 
      0 14px 30px -4px rgba(35, 20, 10, 0.6),
      0 4px 10px rgba(0, 0, 0, 0.25),
      inset 0 0 20px rgba(160, 115, 60, 0.22);
    transform: rotate(-2.2deg) translateY(-6px);
  }
  .label-draft-parchment .parchment-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: #6d330c;
    text-transform: uppercase;
    margin-bottom: 3px;
    display: block;
  }
  .label-draft-parchment .parchment-statement {
    font-family: 'Literata', Georgia, serif;
    font-size: 15px;
    font-weight: 700;
    color: #1f1610;
    line-height: 1.3;
    letter-spacing: -0.01em;
    text-shadow: 0 0 1px rgba(0, 0, 0, 0.15);
    display: block;
  }

  /* 2. НЕ ПОШЛО: Архивный штемпельный талон закрытых гипотез */
  .label-failures-card {
    padding: 9px 15px;
    background: #f4e8e6;
    background-image: linear-gradient(135deg, #faf0ee 0%, #ebd7d4 100%);
    border: 1px solid #d99994;
    border-left: 4px solid #dc2626;
    border-radius: 4px;
    box-shadow: 0 12px 26px -4px rgba(60, 15, 15, 0.5), 0 3px 8px rgba(0, 0, 0, 0.2);
    transform: rotate(1.5deg) translateY(-6px);
  }
  .label-failures-card .tag-crimson-seal {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px;
    font-weight: 800;
    color: #991b1b;
    letter-spacing: 0.1em;
  }
  .label-failures-card .editorial-statement {
    font-family: 'Literata', Georgia, serif;
    font-size: 13px;
    font-weight: 600;
    color: #3b1111;
  }

  /* 3. САЙТЫ / ЛЕНДИНГИ: Физическая пергаментная карточка-закладка проекта */
  .label-blueprint-strip {
    padding: 9px 16px;
    background: #f4ecdc;
    background-image: 
      radial-gradient(circle at 15% 20%, rgba(255, 255, 255, 0.5) 0%, transparent 55%),
      radial-gradient(circle at 85% 80%, rgba(150, 105, 55, 0.14) 0%, transparent 65%),
      linear-gradient(135deg, #f9f2e3 0%, #ebe0ca 100%);
    border: 1px solid rgba(150, 110, 65, 0.45);
    border-left: 3.5px solid #a1440d;
    border-radius: 3px 10px 4px 12px / 12px 3px 10px 4px;
    box-shadow: 
      0 12px 28px -4px rgba(45, 25, 10, 0.5),
      0 3px 8px rgba(0, 0, 0, 0.22),
      inset 0 0 14px rgba(175, 130, 75, 0.18);
    transition: opacity 0.24s cubic-bezier(0.16, 1, 0.3, 1), transform 0.24s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .label-blueprint-strip .editorial-tag {
    font-family: 'Space Grotesk', -apple-system, sans-serif;
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: #6d280a;
    text-transform: uppercase;
    margin-bottom: 2px;
    display: block;
  }

  .label-blueprint-strip .editorial-statement {
    font-family: 'Literata', Georgia, serif;
    font-style: italic;
    font-size: 13px;
    font-weight: 600;
    color: #24140a;
    line-height: 1.3;
    text-shadow: 0 0 1px rgba(0, 0, 0, 0.1);
    display: block;
  }

  /* Сохранение теплой бумажной фактуры и читаемого тёмного текста в режиме НОЧЬ */
  :global([data-theme="night"]) .label-blueprint-strip {
    background: #f1e7d2;
    background-image: 
      radial-gradient(circle at 15% 20%, rgba(255, 255, 255, 0.4) 0%, transparent 55%),
      radial-gradient(circle at 85% 80%, rgba(150, 105, 55, 0.15) 0%, transparent 65%),
      linear-gradient(135deg, #f7efe0 0%, #e8d9bd 100%);
    border: 1px solid rgba(160, 115, 65, 0.5);
    border-left: 3.5px solid #d97706;
    box-shadow: 
      0 14px 32px -4px rgba(0, 0, 0, 0.8),
      0 4px 10px rgba(0, 0, 0, 0.35),
      0 0 20px rgba(245, 158, 11, 0.18),
      inset 0 0 14px rgba(175, 130, 75, 0.22);
  }

  :global([data-theme="night"]) .label-blueprint-strip .editorial-tag {
    color: #78350f;
  }

  :global([data-theme="night"]) .label-blueprint-strip .editorial-statement {
    color: #24140a;
  }

  /* 4. БОТЫ: Терминальная перфолента / электронный билет диспетчера */
  .label-terminal-ticket {
    padding: 8px 15px;
    background: #0d1512;
    background-image: linear-gradient(180deg, #131c18 0%, #0a0f0d 100%);
    border: 1px solid rgba(52, 211, 153, 0.35);
    border-left: 3.5px solid #10b981;
    border-radius: 4px;
    box-shadow: 0 10px 25px -4px rgba(6, 78, 59, 0.4), 0 0 16px rgba(16, 185, 129, 0.12);
  }
  .label-terminal-ticket .editorial-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
  }
  .label-terminal-ticket .editorial-statement {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11.5px;
    font-weight: 500;
    color: #d1fae5;
  }

  /* 5. ВИДЕО: Кадр 35-мм киноплёнки монтажного стола */
  .label-celluloid-strip {
    padding: 8px 15px;
    background: #14110e;
    background-image: 
      radial-gradient(circle at 12px 4px, rgba(255, 255, 255, 0.22) 1.5px, transparent 2px),
      radial-gradient(circle at 12px calc(100% - 4px), rgba(255, 255, 255, 0.22) 1.5px, transparent 2px);
    background-repeat: repeat-x;
    background-size: 16px 100%;
    border: 1px solid rgba(245, 158, 11, 0.4);
    border-top: 2px solid rgba(245, 158, 11, 0.65);
    border-bottom: 2px solid rgba(245, 158, 11, 0.65);
    border-radius: 3px;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.8), 0 0 14px rgba(245, 158, 11, 0.18);
  }
  .label-celluloid-strip .editorial-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9px;
    font-weight: 800;
    color: #f59e0b;
    letter-spacing: 0.12em;
  }
  .label-celluloid-strip .editorial-statement {
    font-family: 'Literata', Georgia, serif;
    font-size: 12.5px;
    font-weight: 600;
    color: #fef3c7;
  }

  /* 6. СЕТЬ: Карточка звездных координат и топологии связей */
  .label-starchart-card {
    padding: 8px 15px;
    background: #0f172a;
    background-image: 
      radial-gradient(circle at 80% 20%, rgba(96, 165, 250, 0.22) 0%, transparent 60%),
      linear-gradient(135deg, #111e38 0%, #090d16 100%);
    border: 1px solid rgba(96, 165, 250, 0.4);
    border-radius: 4px;
    box-shadow: 0 10px 26px -4px rgba(15, 23, 42, 0.8), 0 0 16px rgba(59, 130, 246, 0.18);
  }
  .label-starchart-card .editorial-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px;
    font-weight: 800;
    color: #60a5fa;
    letter-spacing: 0.12em;
  }
  .label-starchart-card .editorial-statement {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: #e0f2fe;
  }

  /* 7. СИСТЕМА // CORE: Архитектурный веленевый чертёж */
  .label-schematic-vellum {
    padding: 8px 15px;
    background: #fbf7ee;
    background-image: 
      linear-gradient(rgba(249, 115, 22, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(249, 115, 22, 0.05) 1px, transparent 1px);
    background-size: 10px 10px;
    border: 1px solid #c9b497;
    border-left: 3.5px solid #f97316;
    border-radius: 4px;
    box-shadow: 0 10px 24px -4px rgba(45, 30, 15, 0.45);
  }
  .label-schematic-vellum .editorial-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9px;
    font-weight: 800;
    color: #ea580c;
    letter-spacing: 0.12em;
  }
  .label-schematic-vellum .editorial-statement {
    font-family: 'Literata', Georgia, serif;
    font-size: 12.5px;
    font-weight: 600;
    color: #271e17;
  }

  /* 8. СЕРБИЯ: Почтовая полевая карточка экспедиции */
  .label-field-dispatch {
    padding: 8px 15px;
    background: #f5eedb;
    background-image: linear-gradient(135deg, #faf3e4 0%, #ebe0c6 100%);
    border: 1px dashed #bfa57a;
    border-left: 3.5px solid #d97706;
    border-radius: 4px;
    box-shadow: 0 10px 24px -4px rgba(40, 28, 15, 0.45);
    transform: rotate(-1.2deg) translateY(-6px);
  }
  .label-field-dispatch .editorial-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px;
    font-weight: 800;
    color: #b45309;
    letter-spacing: 0.1em;
  }
  .label-field-dispatch .editorial-statement {
    font-family: 'Literata', Georgia, serif;
    font-size: 12.5px;
    font-weight: 600;
    color: #261e14;
  }

  /* 9. ВХОДЯЩИЙ: Телефонный коммутатор / прямая линия */
  .label-switchboard-card {
    padding: 8px 15px;
    background: #1c1414;
    border: 1px solid rgba(239, 68, 68, 0.4);
    border-left: 3.5px solid #ef4444;
    border-radius: 4px;
    box-shadow: 0 10px 25px -4px rgba(0, 0, 0, 0.7), 0 0 14px rgba(239, 68, 68, 0.22);
  }
  .label-switchboard-card .editorial-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9px;
    font-weight: 800;
    color: #f87171;
    letter-spacing: 0.12em;
  }
  .label-switchboard-card .editorial-statement {
    font-family: 'Literata', Georgia, serif;
    font-size: 12.5px;
    font-weight: 600;
    color: #fef2f2;
  }

  /* 10. КРУЖКА: Пробковый костер манифеста */
  .label-coaster-tile {
    padding: 8px 15px;
    background: #e9dcbe;
    background-image: radial-gradient(circle at 50% 50%, rgba(180, 140, 90, 0.2) 0%, transparent 80%);
    border: 1px solid #bfab80;
    border-radius: 8px;
    box-shadow: 0 10px 24px -4px rgba(45, 30, 15, 0.45);
  }
  .label-coaster-tile .editorial-tag {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 9.5px;
    font-weight: 800;
    color: #573919;
    letter-spacing: 0.1em;
  }
  .label-coaster-tile .editorial-statement {
    font-family: 'Caveat', cursive;
    font-size: 15px;
    font-weight: 700;
    color: #271a0c;
  }

  /* ПОЗИЦИОНИРОВАНИЕ АРТЕФАКТОВ ПО ОТНОШЕНИЮ К ПРЕДМЕТАМ */
  .label-below-left {
    bottom: -36px;
    left: 10px;
    transform: translateY(6px);
  }
  .label-above-left {
    top: -42px;
    left: 10px;
    transform: translateY(-6px);
  }
  .label-above-center {
    top: -42px;
    left: 50%;
    transform: translate(-50%, -6px);
  }
  .label-above-right {
    top: -42px;
    right: 10px;
    transform: translateY(-6px);
  }
  .label-above-filmstrip {
    top: -42px;
    left: 20px;
    transform: translateY(-6px);
  }
  .label-left-side {
    top: 50%;
    right: calc(100% + 12px);
    transform: translateY(-50%) translateX(6px);
  }

  .hotspot:hover .editorial-float-label,
  .hotspot.is-hovered .editorial-float-label {
    opacity: 1;
    transform: translate(0, 0);
  }
  .hotspot-notebook:hover .label-draft-parchment,
  .hotspot-notebook.is-hovered .label-draft-parchment {
    transform: rotate(-2.2deg) translateY(0);
  }
  .hotspot-failures:hover .label-failures-card,
  .hotspot-failures.is-hovered .label-failures-card {
    transform: rotate(1.5deg) translateY(0);
  }
  .hotspot-trackers:hover .label-field-dispatch,
  .hotspot-trackers.is-hovered .label-field-dispatch,
  .hotspot-srbija:hover .label-field-dispatch,
  .hotspot-srbija.is-hovered .label-field-dispatch {
    transform: rotate(-1.2deg) translateY(0);
  }
  .hotspot-core:hover .editorial-float-label,
  .hotspot-core.is-hovered .editorial-float-label {
    transform: translate(-50%, 0);
  }

  /* ПРАВАЯ ВЫДВИЖНАЯ ПАНЕЛЬ (DRAWER) — ЧАСТЬ ОБЩЕЙ СРЕДЫ РАБОЧЕГО СТОЛА */
  .workbench-drawer {
    position: fixed;
    top: 42px;
    right: 0;
    bottom: 0;
    width: 500px;
    max-width: 100vw;
    background: #171412;
    background-image: 
      radial-gradient(circle at 100% 0%, rgba(245, 158, 11, 0.08) 0%, transparent 60%),
      radial-gradient(circle at 0% 100%, rgba(180, 83, 9, 0.05) 0%, transparent 50%),
      linear-gradient(180deg, rgba(28, 24, 21, 0.98) 0%, rgba(20, 17, 15, 0.98) 100%);
    backdrop-filter: blur(24px);
    border-left: 1px solid rgba(245, 158, 11, 0.22);
    box-shadow: -24px 0 60px rgba(0, 0, 0, 0.75), inset 1px 0 0 rgba(255, 255, 255, 0.05);
    z-index: 60;
    transform: translateX(110%);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), width 0.4s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.4s;
    color: #ede8df;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .workbench-drawer:not(.is-open) {
    box-shadow: none !important;
    visibility: hidden;
    pointer-events: none;
  }

  /* АТМОСФЕРА ПАНЕЛЕЙ ПО ТИПАМ ПРОЕКТОВ (ЛАБОРАТОРНЫЕ ПОВЕРХНОСТИ) */

  /* 1. БОТЫ (код / терминал / сообщения / автоматизация) */
  #modal-myasnaya-troitsa,
  #modal-aichatbot,
  #modal-bots {
    background: #0f1613;
    background-image: 
      radial-gradient(circle at 90% 10%, rgba(34, 197, 94, 0.09) 0%, transparent 55%),
      radial-gradient(circle at 10% 90%, rgba(16, 185, 129, 0.04) 0%, transparent 50%),
      linear-gradient(rgba(52, 211, 153, 0.015) 1px, transparent 1px),
      linear-gradient(180deg, #15201b 0%, #0d1411 100%);
    background-size: auto, auto, 100% 4px, auto;
    border-left: 1px solid rgba(34, 197, 94, 0.3);
  }

  /* 2. САЙТЫ / ЛЕНДИНГИ (интерфейс / браузер / рабочая среда) */
  #modal-sites,
  #modal-english-teacher,
  #modal-twohearts,
  #modal-siteviza,
  #modal-atelier,
  #modal-landasset5,
  #modal-tracker01 {
    background: #181512;
    background-image: 
      radial-gradient(circle at 90% 10%, rgba(234, 88, 12, 0.09) 0%, transparent 55%),
      radial-gradient(circle at 10% 90%, rgba(245, 158, 11, 0.04) 0%, transparent 50%),
      linear-gradient(rgba(245, 158, 11, 0.015) 1px, transparent 1px),
      linear-gradient(90deg, rgba(245, 158, 11, 0.015) 1px, transparent 1px),
      linear-gradient(180deg, #201a16 0%, #14110f 100%);
    background-size: auto, auto, 24px 24px, 24px 24px, auto;
    border-left: 1px solid rgba(234, 88, 12, 0.28);
  }

  /* 3. ВИДЕО (плёнка / монтаж / кадры / рабочий процесс) */
  #modal-video {
    background: #16120e;
    background-image: 
      radial-gradient(circle at 90% 12%, rgba(245, 158, 11, 0.12) 0%, transparent 60%),
      radial-gradient(circle at 10% 88%, rgba(220, 38, 38, 0.06) 0%, transparent 50%),
      linear-gradient(180deg, #1e1712 0%, #110d0a 100%);
    border-left: 1px solid rgba(245, 158, 11, 0.35);
  }

  /* 4. СЕТЬ (карта / координаты / связи / инфраструктура) */
  #modal-network {
    background: #0f1624;
    background-image: 
      radial-gradient(circle at 90% 10%, rgba(59, 130, 246, 0.12) 0%, transparent 55%),
      radial-gradient(circle at 15% 85%, rgba(139, 92, 246, 0.06) 0%, transparent 50%),
      linear-gradient(rgba(59, 130, 246, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(59, 130, 246, 0.02) 1px, transparent 1px),
      linear-gradient(180deg, #131c2e 0%, #0a0f19 100%);
    background-size: auto, auto, 28px 28px, 28px 28px, auto;
    border-left: 1px solid rgba(59, 130, 246, 0.35);
  }

  /* 5. ЧЕРНОВИК (бумага / эскиз / карандаш / идеи) */
  #modal-draft {
    background: #1a1613;
    background-image: 
      radial-gradient(circle at 88% 12%, rgba(217, 119, 6, 0.1) 0%, transparent 55%),
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(180deg, #221c17 0%, #15120f 100%);
    background-size: auto, 20px 20px, 20px 20px, auto;
    border-left: 1px solid rgba(217, 119, 6, 0.3);
  }

  /* 6. ОБО МНЕ (лабораторный журнал / личный архив / заметки автора) */
  #modal-about {
    background: #1b1612;
    background-image: 
      radial-gradient(circle at 90% 10%, rgba(245, 158, 11, 0.14) 0%, transparent 60%),
      radial-gradient(circle at 10% 90%, rgba(180, 83, 9, 0.06) 0%, transparent 50%),
      linear-gradient(180deg, #241c16 0%, #15110d 100%);
    border-left: 1px solid rgba(245, 158, 11, 0.35);
  }

  /* 7. РЕЛОКАНТ СЕРБИЯ (полевой дневник / исследование / реальный опыт) */
  #modal-srbija {
    background: #1a1612;
    background-image: 
      radial-gradient(circle at 90% 12%, rgba(245, 158, 11, 0.12) 0%, transparent 55%),
      radial-gradient(circle at 12% 88%, rgba(217, 119, 6, 0.06) 0%, transparent 50%),
      linear-gradient(180deg, #231d17 0%, #16120e 100%);
    border-left: 1px solid rgba(245, 158, 11, 0.35);
  }

  /* 8. НЕ ПОШЛО (архив закрытых гипотез / разбор ошибок / выводы) */
  #modal-failures {
    background: #1a1212;
    background-image: 
      radial-gradient(circle at 90% 12%, rgba(239, 68, 68, 0.1) 0%, transparent 50%),
      radial-gradient(circle at 12% 88%, rgba(185, 28, 28, 0.05) 0%, transparent 50%),
      linear-gradient(180deg, #221515 0%, #140d0d 100%);
    border-left: 1px solid rgba(239, 68, 68, 0.3);
  }

  /* 9. СИСТЕМА // CORE (чертёж / схема связей / архитектура) */
  #modal-core {
    background: #181410;
    background-image: 
      radial-gradient(circle at 90% 10%, rgba(249, 115, 22, 0.12) 0%, transparent 55%),
      linear-gradient(rgba(249, 115, 22, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(249, 115, 22, 0.02) 1px, transparent 1px),
      linear-gradient(180deg, #201a14 0%, #130f0c 100%);
    background-size: auto, 24px 24px, 24px 24px, auto;
    border-left: 1px solid rgba(249, 115, 22, 0.35);
  }

  /* 10. ВХОДЯЩИЙ (прямая телефонная линия) */
  #modal-incoming {
    background: #1b1212;
    background-image: 
      radial-gradient(circle at 90% 12%, rgba(239, 68, 68, 0.12) 0%, transparent 55%),
      linear-gradient(180deg, #241515 0%, #150d0d 100%);
    border-left: 1px solid rgba(239, 68, 68, 0.35);
  }

  /* 11. МАНИФЕСТ (дерево и керамо-костер) — Компактное меню кружки */
  #modal-manifesto {
    top: 50px;
    bottom: 40px;
    max-height: calc(100vh - 90px);
    background: #191512;
    background-image: 
      radial-gradient(circle at 90% 10%, rgba(245, 158, 11, 0.1) 0%, transparent 55%),
      linear-gradient(180deg, #211b16 0%, #14110e 100%);
    border-left: 1px solid rgba(245, 158, 11, 0.3);
    border-top: 1px solid rgba(245, 158, 11, 0.15);
    border-bottom: 1px solid rgba(245, 158, 11, 0.15);
    border-radius: 12px 0 0 12px;
    box-shadow: -16px 0 45px rgba(0, 0, 0, 0.8);
  }

  #modal-manifesto:not(.is-expanded) {
    width: 370px;
  }

  #modal-manifesto .drawer-content {
    padding: 10px 14px;
    gap: 7px;
    overflow-y: auto;
  }

  #modal-manifesto .drawer-header {
    padding-bottom: 6px;
  }

  #modal-manifesto .case-hero-strip {
    padding: 8px 12px;
    margin-bottom: 2px;
    border-radius: 6px;
  }

  #modal-manifesto .status-live {
    font-size: 9.5px;
    margin-bottom: 2px;
  }

  #modal-manifesto .case-title {
    font-size: 15px;
    margin: 1px 0;
  }

  #modal-manifesto .case-lead {
    font-size: 11px;
    line-height: 1.3;
    margin: 0;
    opacity: 0.85;
  }

  #modal-manifesto .rules-stack {
    gap: 5px;
  }

  #modal-manifesto .rule-card {
    padding: 6px 10px;
    gap: 8px;
    border-radius: 5px;
  }

  #modal-manifesto .rule-num {
    font-size: 13px;
    min-width: 18px;
  }

  #modal-manifesto .rule-content strong {
    font-size: 11.5px;
    line-height: 1.2;
    margin-bottom: 1px;
  }

  #modal-manifesto .rule-content p {
    font-size: 10.5px;
    line-height: 1.25;
    margin: 0;
  }

  .workbench-drawer.is-open {
    transform: translateX(0);
  }

  .workbench-drawer.is-expanded {
    width: 92vw;
    max-width: 1280px;
  }

  .drawer-content {
    flex-grow: 1;
    overflow-y: auto;
    padding: 24px 28px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 14px;
    border-bottom: 1px solid rgba(245, 158, 11, 0.14);
  }

  .drawer-header-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .drawer-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 700;
  }

  .case-badge {
    padding: 2px 8px;
    border-radius: 4px;
    background: rgba(245, 158, 11, 0.08);
    border: 1px solid rgba(245, 158, 11, 0.2);
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    font-weight: 700;
    color: #f59e0b;
  }

  .drawer-header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  /* узкий экран: подпись раздела и кнопки управления переносятся, «Свернуть/Закрыть» всегда на экране */
  @media (max-width: 600px) {
    .drawer-header { flex-wrap: wrap; row-gap: 10px; }
    .drawer-header-left { flex-wrap: wrap; min-width: 0; max-width: 100%; row-gap: 6px; }
    .drawer-header-actions { flex-wrap: wrap; margin-left: auto; max-width: 100%; }
  }

  .expand-drawer-btn, .close-drawer-btn {
    padding: 5px 11px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(245, 158, 11, 0.2);
    color: #ede8df;
    cursor: pointer;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    transition: all 0.2s ease;
  }
  .expand-drawer-btn:hover, .close-drawer-btn:hover {
    background: rgba(245, 158, 11, 0.15);
    border-color: rgba(245, 158, 11, 0.4);
    color: #ffffff;
  }

  .case-body {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .status-live {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    color: #34d399;
    letter-spacing: 0.05em;
  }

  .case-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 26px;
    font-weight: 700;
    line-height: 1.2;
    color: #ffffff;
    margin-top: 6px;
  }

  .case-lead {
    font-size: 15.5px;
    font-weight: 500;
    line-height: 1.55;
    color: #d6d3d1;
    margin-top: 8px;
  }

  .case-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 14px;
  }

  .case-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 16px;
    border-radius: 6px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .btn-primary {
    background: #ea580c;
    color: #ffffff;
  }
  .btn-primary:hover {
    background: #f97316;
    transform: translateY(-1px);
  }
  .btn-secondary {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: #e7e5e4;
  }
  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
  }
  .btn-catalog-back {
    background: rgba(245, 158, 11, 0.12);
    border: 1px solid rgba(245, 158, 11, 0.35);
    color: #fde68a;
    cursor: pointer;
  }
  .btn-catalog-back:hover {
    background: rgba(245, 158, 11, 0.24);
    border-color: rgba(245, 158, 11, 0.55);
    color: #ffffff;
    transform: translateY(-1px);
  }

  /* КАТАЛОГ САЙТОВ И ЛЕНДИНГОВ В ПРАВОЙ ПАНЕЛИ */
  .sites-catalog-grid {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 8px;
  }
  .workbench-drawer.is-expanded .sites-catalog-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .sites-catalog-grid > * { min-width: 0; }
  /* узкий экран: карточки каталога в одну колонку */
  @media (max-width: 860px) {
    .workbench-drawer.is-expanded .sites-catalog-grid { grid-template-columns: minmax(0, 1fr); }
  }
  .catalog-project-card {
    background: rgba(26, 21, 17, 0.85);
    background-image: linear-gradient(135deg, rgba(38, 30, 24, 0.85) 0%, rgba(22, 17, 14, 0.95) 100%);
    border: 1px solid rgba(245, 158, 11, 0.2);
    border-left: 3.5px solid #ea580c;
    border-radius: 8px;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .catalog-project-card:hover {
    background: rgba(36, 28, 22, 0.95);
    border-color: rgba(245, 158, 11, 0.45);

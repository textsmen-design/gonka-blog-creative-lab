  /* Пульсирующий отблеск на сургучной печати закрытого рулона */
  .sites-pulse-seal {
    position: absolute;
    top: 36%;
    left: 58%;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(239, 68, 68, 0.5) 0%, rgba(220, 38, 38, 0.15) 50%, rgba(0, 0, 0, 0) 70%);
    pointer-events: none;
    animation: scroll-seal-shimmer 3.2s infinite ease-in-out;
  }

  /* 2. Развёрнутый свиток (плавно разворачивается в обе стороны влево и вправо по горизонтали) */
  .sites-unrolled-wrapper {
    position: absolute;
    top: 4%;
    left: 0;
    width: 100%;
    height: 92%;
    display: flex;
    align-items: stretch;
    pointer-events: none;
    opacity: 0;
    transform: scaleX(0.18);
    transform-origin: center center;
    clip-path: inset(0 41% 0 41%);
    filter: drop-shadow(0 12px 24px rgba(0, 0, 0, 0.8));
    transition: opacity 0.3s ease,
                transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                clip-path 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                filter 0.4s ease;
  }

  .hotspot-scroll-sites.physical-scroll-horizontal:hover .sites-closed-wrapper,
  .hotspot-scroll-sites.physical-scroll-horizontal.is-hovered .sites-closed-wrapper {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.92);
    pointer-events: none;
  }

  .hotspot-scroll-sites.physical-scroll-horizontal:hover .sites-unrolled-wrapper,
  .hotspot-scroll-sites.physical-scroll-horizontal.is-hovered .sites-unrolled-wrapper {
    opacity: 1;
    pointer-events: auto;
    transform: scaleX(1);
    clip-path: inset(0 0 0 0);
    filter: drop-shadow(0 18px 34px rgba(0, 0, 0, 0.9));

<script>
  import { AUTHOR_POINT, formatCoords, tzLabel, tzName, clockText, GEO_TEXT, stateFromError } from '../scene/geo.mjs';

  function initSpatialWorkbench() {
    // 1. Часы и часовой пояс посетителя (по системным часам устройства)
    const clockEl = document.getElementById('live-clock');
    const tzEl = document.getElementById('live-tz');
    function updateClock() {
      const now = new Date();
      if (clockEl) clockEl.textContent = clockText(now);
      if (tzEl) {
        tzEl.textContent = tzLabel(now);
        const zone = tzName();
        if (zone) tzEl.setAttribute('title', zone);
      }
    }
    setInterval(updateClock, 1000);
    updateClock();

    // 1b. Координаты: геолокация браузера по нажатию кнопки (или сразу, если доступ уже разрешён), иначе авторская точка.
    // Координаты живут только в памяти страницы: не сохраняются и никуда не отправляются.
    const geoRoot = document.getElementById('live-geo');
    const coordsEl = document.getElementById('live-coords');
    const coordsSrcEl = document.getElementById('live-coords-src');
    const geoBtn = document.getElementById('geo-btn') as HTMLButtonElement | null;
    const geoHint = document.getElementById('geo-hint');
    let hintTimer: number | undefined;
    function setGeoState(state: string, lat?: number, lon?: number) {
      let text: string | null = null;
      if (state === 'granted') text = formatCoords(lat as number, lon as number);
      if (state === 'granted' && !text) { state = 'error'; }
      const tt = (GEO_TEXT as any)[state];
      geoRoot?.setAttribute('data-state', state);
      if (coordsEl) {
        coordsEl.textContent = state === 'granted' && text ? text : AUTHOR_POINT.text;
        coordsEl.setAttribute('data-source', state === 'granted' ? 'geolocation' : 'author');
        coordsEl.setAttribute('title', state === 'granted' ? 'Ваше местоположение (видно только вам)' : 'Координаты авторской точки');
      }
      if (coordsSrcEl) coordsSrcEl.textContent = tt.src;
      if (geoBtn) {
        geoBtn.textContent = tt.btn;
        geoBtn.hidden = state === 'fallback';
        geoBtn.disabled = state === 'loading';
      }
      if (geoHint) {
        geoHint.textContent = tt.hint;
        if (state !== 'idle') {                       // показываем причину несколько секунд
          geoHint.classList.add('is-shown');
          window.clearTimeout(hintTimer);
          hintTimer = window.setTimeout(() => geoHint.classList.remove('is-shown'), 7000);
        }
      }
    }
    let geoBusy = false;
    function requestVisitorPosition() {
      if (geoBusy) return;                              // не более одного запроса одновременно
      if (!('geolocation' in navigator) || !navigator.geolocation || !window.isSecureContext) { setGeoState('fallback'); return; }
      geoBusy = true;
      setGeoState('loading');
      // страховка от «вечной загрузки», если браузер не вызвал ни один из обработчиков
      const watchdog = window.setTimeout(() => { if (geoBusy) { geoBusy = false; setGeoState('timeout'); } }, 16000);
      const finish = (fn: () => void) => { if (!geoBusy) return; geoBusy = false; window.clearTimeout(watchdog); fn(); };
      try {
        navigator.geolocation.getCurrentPosition(
          (pos) => finish(() => setGeoState('granted', pos.coords.latitude, pos.coords.longitude)),
          (err) => finish(() => setGeoState(stateFromError(err))),
          { enableHighAccuracy: false, timeout: 12000, maximumAge: 600000 }
        );
      } catch { finish(() => setGeoState('error')); }
    }
    geoBtn?.addEventListener('click', async () => {
      // Если доступ уже запрещён в браузере, повторный запрос ничего не покажет — объясняем, что делать
      try {
        const st = await navigator.permissions?.query({ name: 'geolocation' as PermissionName });
        if (st && st.state === 'denied') { setGeoState('denied'); return; }
      } catch { /* Permissions API недоступен */ }
      requestVisitorPosition();
    });
    // Без навязчивых запросов: сайт сам ничего не спрашивает. Если доступ уже был разрешён ранее — просто показываем место.
    if (!('geolocation' in navigator) || !navigator.geolocation || !window.isSecureContext) {
      setGeoState('fallback');
    } else if (navigator.permissions && navigator.permissions.query) {
      navigator.permissions.query({ name: 'geolocation' as PermissionName }).then((st) => {
        if (st.state === 'granted') setTimeout(requestVisitorPosition, 800);
        else if (st.state === 'denied') setGeoState('denied');
      }, () => { /* оставляем кнопку */ });
    }

    // 2. Открытие, разворачивание и закрытие досье
    const hotspots = document.querySelectorAll('.hotspot');
    const drawers = document.querySelectorAll('.workbench-drawer');
    const backdrop = document.getElementById('drawer-backdrop');
    const closeButtons = document.querySelectorAll('.close-drawer-btn');
    const expandButtons = document.querySelectorAll('.expand-drawer-btn');

    function openDrawer(targetId: string) {
      closeAllDrawers();
      const target = document.getElementById(targetId);
      if (target && backdrop) {
        target.classList.remove('is-expanded');
        target.classList.add('is-open');
        backdrop.classList.add('is-active');
      }
      document.querySelectorAll('.cabinet-nav-item').forEach((item) => {
        if (item.getAttribute('data-target') === targetId) {
          item.classList.add('is-active');
        } else {
          item.classList.remove('is-active');
        }
      });
    }

    // Предметы сцены (src/scene) просят открыть панель через событие — порядок загрузки скриптов не важен
    document.addEventListener('gonka:open', (e) => {
      const id = (e as CustomEvent).detail?.target;
      if (id) openDrawer(id);
    });

    function toggleExpand(drawer: HTMLElement) {
      const isExpanded = drawer.classList.contains('is-expanded');
      const label = drawer.querySelector('.expand-label');
      if (isExpanded) {
        drawer.classList.remove('is-expanded');
        if (label) label.textContent = 'НА ВЕСЬ СТОЛ';
      } else {
        drawer.classList.add('is-expanded');
        if (label) label.textContent = 'СВЕРНУТЬ В ПАНЕЛЬ';
      }
    }

    function closeAllDrawers() {
      drawers.forEach((d) => {
        d.classList.remove('is-open');
        d.classList.remove('is-expanded');
        const label = d.querySelector('.expand-label');
        if (label) label.textContent = 'НА ВЕСЬ СТОЛ';
      });
      if (backdrop) backdrop.classList.remove('is-active');
      document.querySelectorAll('.cabinet-nav-item').forEach((item) => {
        item.classList.remove('is-active');
      });
    }

    hotspots.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const targetId = btn.getAttribute('data-target');
        if (targetId) {
          if (btn.classList.contains('cabinet-nav-item')) {
            const deskHotspot = document.querySelector(`.workbench-frame .hotspot[data-target="${targetId}"]`) as HTMLElement;
            if (deskHotspot) {
              deskHotspot.scrollIntoView({ behavior: 'smooth', block: 'center', inline: 'center' });
              deskHotspot.classList.add('is-hovered');
              setTimeout(() => {
                deskHotspot.classList.remove('is-hovered');
              }, 1800);
            }
          }
          openDrawer(targetId);
        }
      });
      if (btn.tagName !== 'BUTTON') {
        btn.addEventListener('keydown', (e) => {
          const keyEv = e as KeyboardEvent;
          if (keyEv.key === 'Enter' || keyEv.key === ' ') {
            if (e.target === btn) {
              e.preventDefault();
              e.stopPropagation();
              const targetId = btn.getAttribute('data-target');
              if (targetId) {
                if (btn.classList.contains('cabinet-nav-item')) {
                  const deskHotspot = document.querySelector(`.workbench-frame .hotspot[data-target="${targetId}"]`) as HTMLElement;
                  if (deskHotspot) {
                    deskHotspot.scrollIntoView({ behavior: 'smooth', block: 'center', inline: 'center' });
                    deskHotspot.classList.add('is-hovered');
                    setTimeout(() => {
                      deskHotspot.classList.remove('is-hovered');
                    }, 1800);
                  }
                }
                openDrawer(targetId);
              }
            }
          }
        });
      }
    });

    document.querySelectorAll('[data-open-drawer]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const targetId = btn.getAttribute('data-open-drawer');
        if (targetId) {
          openDrawer(targetId);
        }
      });
    });

    closeButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        closeAllDrawers();
      });
    });

    document.querySelectorAll('a.topbar-brand, a.workbench-table-logo-link, a.scene-brand').forEach((brandLink) => {
      brandLink.addEventListener('click', (e) => {
        const anyOpen = document.querySelector('.workbench-drawer.is-open');
        if (anyOpen) {
          e.preventDefault();
          closeAllDrawers();
          if (window.location.search) {
            history.pushState(null, '', '/');
          }
        }
      });
    });

    expandButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const drawer = btn.closest('.workbench-drawer') as HTMLElement;
        if (drawer) {
          toggleExpand(drawer);
        }
      });
    });

    backdrop?.addEventListener('click', closeAllDrawers);

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeAllDrawers();
      }
    });

    // 3. Тумблер темы (День / Ночь)
    const toggleBtn = document.getElementById('desk-theme-toggle');
    const themeIcon = document.getElementById('desk-theme-icon');
    const themeLabel = document.getElementById('desk-theme-label');
    const html = document.documentElement;

    function applyDeskTheme(theme: string) {
      if (theme !== 'night' && theme !== 'day') theme = 'day';
      html.setAttribute('data-theme', theme);
      const night = theme === 'night';
      toggleBtn?.setAttribute('aria-checked', String(night));
      toggleBtn?.setAttribute('aria-label', night ? 'Ночной режим включён. Переключить на день' : 'Дневной режим включён. Переключить на ночь');
      if (themeIcon && themeLabel) {
        themeIcon.textContent = night ? '☽' : '☼';
        themeLabel.textContent = night ? 'НОЧЬ' : 'ДЕНЬ';
      }
    }

    const currentHour = new Date().getHours();
    const defaultTheme = (currentHour >= 20 || currentHour < 7) ? 'night' : 'day';
    let saved = defaultTheme;
    try { saved = localStorage.getItem('gonka-theme') || defaultTheme; } catch { /* приватный режим */ }
    applyDeskTheme(saved);

    toggleBtn?.addEventListener('click', () => {
      const current = html.getAttribute('data-theme');
      const next = current === 'night' ? 'day' : 'night';
      try { localStorage.setItem('gonka-theme', next); } catch { /* приватный режим */ }
      applyDeskTheme(next);
    });

    // 3b. Сцена: масштаб свитков (--k), положение на мобильных, касания свитков
    const stage = document.getElementById('scene-stage');
    if (stage) {
      const clip = stage.parentElement as HTMLElement;
      const updateScale = () => stage.style.setProperty('--k', String(stage.clientWidth / 1619));
      updateScale();
      if ('ResizeObserver' in window) new ResizeObserver(updateScale).observe(stage);
      else window.addEventListener('resize', updateScale);
      if (window.matchMedia('(max-width: 767px)').matches) {
        clip.scrollLeft = (clip.scrollWidth - clip.clientWidth) * 0.3;
      }

      // Мышиный клик не должен оставлять фокус на свитке: иначе :focus-within удерживает раскрытие после ухода курсора
      stage.querySelectorAll<HTMLElement>('.sites-closed-img, .bots-closed-img, .scroll-closed-img').forEach((img) => {
        img.addEventListener('mousedown', (e) => e.preventDefault());
      });

      // Подписи предметов у края сцены сдвигаются внутрь видимой области
      const placeTip = (e: Event) => {
        const hit = (e.target as HTMLElement).closest?.('.obj-hit');
        const tip = hit?.parentElement?.querySelector<HTMLElement>('.obj-tip');
        if (!tip) return;
        tip.style.transition = 'none';                 // измеряем без анимации, иначе getBoundingClientRect вернёт промежуточное положение
        tip.style.setProperty('--tip-dx', '0px');
        const r = tip.getBoundingClientRect();
        const c = clip.getBoundingClientRect();
        const left = Math.max(c.left, 0) + 6, right = Math.min(c.right, window.innerWidth) - 6;
        const dx = Math.max(0, left - r.left) - Math.max(0, r.right - right);
        tip.style.setProperty('--tip-dx', `${dx}px`);
        void tip.offsetWidth;
        tip.style.transition = '';
      };
      stage.addEventListener('mouseover', placeTip);
      stage.addEventListener('focusin', placeTip);

      // На сенсорных экранах первое касание раскрывает свиток, второе — открывает его панель
      const touchOnly = window.matchMedia('(hover: none)');
      const scrolls = Array.from(stage.querySelectorAll<HTMLElement>('.hotspot-scroll-sites, .hotspot-scroll-bots, .hotspot-scroll'));
      const closeScrolls = (except?: HTMLElement) => scrolls.forEach((sc) => { if (sc !== except) sc.classList.remove('is-hovered'); });
      scrolls.forEach((sc) => {
        sc.addEventListener('click', (e) => {
          if (!touchOnly.matches) return;
          const inside = (e.target as HTMLElement).closest('[data-open-drawer], .sites-screen-chip');
          if (inside) return;
          if (!sc.classList.contains('is-hovered')) {
            e.stopPropagation();
            e.preventDefault();
            closeScrolls(sc);
            sc.classList.add('is-hovered');
          }
        }, true);
      });
      document.addEventListener('click', (e) => {
        if (!touchOnly.matches) return;
        if (!(e.target as HTMLElement).closest('.hotspot-scroll-sites, .hotspot-scroll-bots, .hotspot-scroll')) closeScrolls();
      });

      // Предметы стола: клик/Enter/касание открывают панель
      stage.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-scene-target]');
        const id = btn?.getAttribute('data-scene-target');
        if (id) document.dispatchEvent(new CustomEvent('gonka:open', { detail: { target: id } }));
      });
    }

    // 4. Проверка URL-параметров
    const urlParams = new URLSearchParams(window.location.search);
    const themeParam = urlParams.get('theme');
    if (themeParam) {
      applyDeskTheme(themeParam);
    }
    const openParam = urlParams.get('open');
    if (openParam) {
      openDrawer(openParam);
      if (urlParams.get('expanded') === 'true') {
        const target = document.getElementById(openParam);
        if (target) toggleExpand(target);
      }
    }
    const hoverParam = urlParams.get('hover');
    if (hoverParam) {
      document.querySelector(`.hotspot[data-target="${hoverParam}"]`)?.classList.add('is-hovered');
    }
  }

  initSpatialWorkbench();
</script>

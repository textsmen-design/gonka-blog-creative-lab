    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
    flex-wrap: wrap;
  }
  .catalog-open-btn {
    padding: 7px 13px;
    border-radius: 5px;
    background: #ea580c;
    color: #ffffff;

---
// src/pages/index.astro
import SpatialWorkbench from '../components/SpatialWorkbench.astro';

import site from '../data/site.json';

const title = site.meta.title;
const description = site.meta.description;
---

<!DOCTYPE html>
<html lang="ru" data-theme="day">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href="https://gonka.blog/" />
  <meta name="robots" content="index, follow" />
  <meta name="author" content="Олег" />
  <meta name="theme-color" content="#1c1b19" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="GONKA.BLOG" />
  <meta property="og:locale" content="ru_RU" />
  <meta property="og:url" content="https://gonka.blog/" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://gonka.blog/scene/day.jpg" />
  <meta property="og:image:width" content="1672" />
  <meta property="og:image:height" content="940" />
  <meta property="og:image:alt" content="GONKA.BLOG: рабочий стол цифровой лаборатории с проектами Олега" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://gonka.blog/scene/day.jpg" />

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "https://gonka.blog/#website",
        "name": "GONKA.BLOG",
        "url": "https://gonka.blog/",
        "inLanguage": "ru",
        "description": "Личная цифровая лаборатория: лендинги, Telegram-боты и веб-сервисы."
      },
      {
        "@type": "Person",
        "@id": "https://gonka.blog/#author",
        "name": "Олег",
        "url": "https://gonka.blog/",
        "jobTitle": "Разработчик Telegram-ботов, сайтов и веб-сервисов",
        "description": "Делаю Telegram-системы, лендинги и веб-сервисы: от разбора задачи до запуска и проверки.",
        "knowsAbout": ["Telegram-боты", "Python", "Node.js", "TypeScript", "PHP", "Astro", "Лендинги", "Веб-сервисы", "Автоматизация", "ИИ-ассистенты"],
        "sameAs": [
          "https://t.me/lonelysvobodny",
          "https://www.youtube.com/@gnkgonkai",
          "https://www.fl.ru/users/textsmen/",
          "https://kwork.ru/user/textsmen",
          "https://uslugi.yandex.ru/profile/OlegB-3420530",
          "https://marketplace.zerocoder.ru/zerocoder/22058",
          "https://github.com/textsmen-design"
        ]
      },
      {
        "@type": "ProfessionalService",
        "@id": "https://gonka.blog/#service",
        "name": "GONKA.BLOG — разработка Telegram-ботов, сайтов и веб-сервисов",
        "url": "https://gonka.blog/",
        "provider": { "@id": "https://gonka.blog/#author" },
        "areaServed": "RU",
        "serviceType": [
          "Разработка Telegram-ботов и каналов",
          "Разработка лендингов и сайтов-визиток",
          "Разработка веб-сервисов и трекеров задач",
          "Видео с ИИ-ведущим"
        ]
      },
      {
        "@type": "ItemList",
        "@id": "https://gonka.blog/#projects",
        "name": "Проекты GONKA.BLOG",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "item": { "@type": "CreativeWork", "name": "Мясная Троица: Telegram-бот, канал и чат о ценах на продукты", "url": "https://t.me/myasnaya_troitsa_bot" } },
          { "@type": "ListItem", "position": 2, "item": { "@type": "CreativeWork", "name": "Politpersona: автоматический новостной канал в Telegram", "url": "https://t.me/politpersona" } },
          { "@type": "ListItem", "position": 3, "item": { "@type": "CreativeWork", "name": "Детективный клуб: игровой Telegram-бот", "url": "https://t.me/AI_CH_BOT_univers_bot" } },
          { "@type": "ListItem", "position": 4, "item": { "@type": "CreativeWork", "name": "RELOCA: платформа для переезда в Сербию", "url": "https://reloca.gonka.blog" } },
          { "@type": "ListItem", "position": 5, "item": { "@type": "CreativeWork", "name": "English Teacher: лендинг преподавателя (демо)", "url": "https://english.gonka.blog" } },
          { "@type": "ListItem", "position": 6, "item": { "@type": "CreativeWork", "name": "TwoHearts: лендинг вечеров знакомств (демо)", "url": "https://twohearts.gonka.blog" } },
          { "@type": "ListItem", "position": 7, "item": { "@type": "CreativeWork", "name": "Siteviza: сайт-визитка автора (демо)", "url": "https://siteviza.gonka.blog" } },
          { "@type": "ListItem", "position": 8, "item": { "@type": "CreativeWork", "name": "Atelier: лендинг студии пошива (демо)", "url": "https://atelier.gonka.blog" } },
          { "@type": "ListItem", "position": 9, "item": { "@type": "CreativeWork", "name": "LandAsset5: лендинг земельного актива (демо)", "url": "https://landasset5.gonka.blog" } },
          { "@type": "ListItem", "position": 10, "item": { "@type": "CreativeWork", "name": "Stopa: трекер задач (демо)", "url": "https://tracker-01.gonka.blog/" } },
          { "@type": "ListItem", "position": 11, "item": { "@type": "CreativeWork", "name": "TaskFlow: учёт задач и сотрудников (демо)", "url": "https://tracker-02.gonka.blog/" } }
        ]
      }
    ]
  }
  </script>

  <!-- Google Fonts: Space Grotesk, JetBrains Mono, Inter, Caveat, Unbounded, Literata -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600;700&family=Literata:ital,opsz,wght@0,7..72,500;0,7..72,600;1,7..72,500;1,7..72,600&family=Space+Grotesk:wght@500;600;700&family=Unbounded:wght@600;700;800&subset=cyrillic&display=swap" rel="stylesheet">

  <style is:global>
    :root {
      /* Дневной световой стол (Warm Drafting Table) */
      --desk-base: #1c1b19;
      --desk-card: #fdfbf7;
      --desk-border: #e6dfd3;
      --desk-text: #1a1917;
      --desk-muted: #5e5950;
      --desk-accent: #ea580c;
      --desk-amber: #f59e0b;
      --nav-bg: rgba(28, 27, 25, 0.95);
      --light-beam: radial-gradient(circle at 35% 45%, rgba(255, 235, 190, 0.45) 0%, transparent 65%);
    }

    [data-theme="night"] {
      /* Ночной световой стол (Darkroom Lightbox) */
      --desk-base: #0f0e0d;
      --desk-card: #1c1b1a;
      --desk-border: #2e2d2a;
      --desk-text: #f3efe6;
      --desk-muted: #9e978b;
      --desk-accent: #f97316;
      --desk-amber: #fbbf24;
      --nav-bg: rgba(15, 14, 13, 0.95);
      --light-beam: radial-gradient(circle at 35% 45%, rgba(249, 115, 22, 0.2) 0%, transparent 65%);
    }

    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      min-height: 100vh;
      overflow-x: hidden;
      font-family: 'Inter', system-ui, sans-serif;
      background-color: var(--desk-base);
      color: var(--desk-text);
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      user-select: none;
      -webkit-user-select: none;
      transition: background-color 0.8s ease, color 0.8s ease;
    }

    .min-h-screen { min-height: 100vh; }
    .w-full { width: 100%; }
    .overflow-x-hidden { overflow-x: hidden; }
    .antialiased { -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }
    .select-none { user-select: none; -webkit-user-select: none; }
    .text-amber-400 { color: #fbbf24; }

    ::selection {
      background-color: #ea580c;
      color: #ffffff;
    }
  </style>
</head>
<body class="min-h-screen w-full overflow-x-hidden antialiased select-none">

  <!-- Интерактивный пространственный верстак GONKA.BLOG -->
  <SpatialWorkbench />

</body>
</html>
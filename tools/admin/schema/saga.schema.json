{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Панель саги «Не пролистывай меня» (пергамент на стене)",
  "type": "object",
  "additionalProperties": false,
  "required": ["tag", "status", "title", "lead", "blocks", "cta"],
  "properties": {
    "tag": { "type": "string", "minLength": 1, "maxLength": 80 },
    "status": { "type": "string", "maxLength": 120 },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "lead": { "type": "string", "maxLength": 2000 },
    "blocks": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["heading", "text"],
        "properties": {
          "heading": { "type": "string", "maxLength": 200 },
          "text": { "type": "string", "maxLength": 10000 },
          "list": { "type": "array", "maxItems": 30, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
          "media": { "type": "string", "maxLength": 250 },
          "mediaAlt": { "type": "string", "maxLength": 300 }
        }
      }
    },
    "cta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "url": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    }
  }
}

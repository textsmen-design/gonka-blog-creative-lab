{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Записи большой книги",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "summary",
          "date",
          "published",
          "section"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "published": {
            "type": "boolean"
          },
          "section": {
            "type": "string",
            "enum": [
              "lab",
              "notes"
            ]
          },
          "url": {
            "type": "string",
            "maxLength": 2048
          },
          "videoUrl": {
            "type": "string",
            "maxLength": 2048
          },
          "attachment": {
            "type": "string",
            "maxLength": 250
          }
        }
      }
    }
  }
}
